// Restore session on load
(function restoreOnLoad() {
    try {
        const raw = localStorage.getItem(SESSION_KEY);
        let session;
        if (raw) {
            session = JSON.parse(raw);
        } else {
            // Load default demo on first visit
            session = defaultSession;
            isDemoLoaded = true;
        }
        if (session && session.elements && session.elements.length > 0) {
            // Small delay to ensure Three.js scene is ready
            setTimeout(() => {
                loadSession(session);
                if (raw) {
                    const d = new Date(session.savedAt);
                    const when = isNaN(d) ? '' : ` (${d.toLocaleDateString()})`;
                    showSessionStatus('↺ Session restaurée' + when);
                } else {
                    showSessionStatus('✓ Configuration de démonstration chargée');
                }
            }, 200);
        }
    } catch(e) { console.warn('Session restore failed:', e); }
})();


