<div id="canvas-container">
    <!-- NOUVEAU BLOC STATS ICI -->
    <div id="hud-undo-redo">
        <button id="undoBtn" class="hud-btn" title="Annuler (Ctrl+Z)">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z"/></svg>
        </button>
        <button id="redoBtn" class="hud-btn" title="Refaire (Ctrl+Y)">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z"/></svg>
        </button>
    </div>
    <div id="hud-stats">
        <div class="hud-stat-row">
            <span data-i18n="stats-label" style="color:var(--text-muted);">Total Éléments</span>
            <span id="hexCount" style="color:var(--accent);font-weight:700;">0</span>
        </div>
        <div class="hud-stat-row">
            <span data-i18n="stats-size-label" style="color:var(--text-muted);">Taille</span>
            <span id="pieceSize" style="color:var(--text-main);font-weight:600;">— × —</span>
        </div>
    </div>

    <div id="hud">
        <div id="hud-buttons">
            <button id="langBtn" class="hud-btn" style="font-weight:700;letter-spacing:.5px;">EN</button>
            <button id="resetViewBtn" class="hud-btn">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
                <span data-i18n="hud-reset">Centrer</span>
            </button>
            <button id="gridToggleBtn" class="hud-btn">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M3 3h7v7H3zm0 11h7v7H3zm11-11h7v7h-7zm0 11h7v7h-7z"/></svg>
                <span data-i18n="hud-grid">Grille</span>
            </button>
            <button id="viewToggleBtn" class="hud-btn" title="Basculer vue (P)" style="padding:7px 10px;">
                <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
                    <polygon points="10,3 17,7 10,11 3,7" fill="rgba(255,255,255,0.06)"/>
                    <polygon points="3,7 10,11 10,17 3,13" fill="rgba(255,255,255,0.03)"/>
                    <polygon points="17,7 10,11 10,17 17,13" fill="rgba(255,255,255,0.09)"/>
                </svg>
            </button>
        </div>
        <div id="hud-controls">
            <div class="hud-title" data-i18n="hud-shortcuts-title">Raccourcis</div>
            <div class="hud-row"><span data-i18n="hud-undo">Annuler</span><span><span class="hud-key">Ctrl</span>+<span class="hud-key">Z</span></span></div>
            <div class="hud-row"><span data-i18n="hud-redo">Refaire</span><span><span class="hud-key">Ctrl</span>+<span class="hud-key">Y</span></span></div>
            <div class="hud-row"><span data-i18n="hud-place">Poser / supprimer</span><span><span class="hud-key">Clic</span></span></div>
            <div class="hud-row"><span data-i18n="hud-delete">Supprimer pièce</span><span><span class="hud-key" data-i18n="hud-delete-key">Clic droit</span></span></div>
            <div class="hud-row"><span data-i18n="hud-lock-rotation">Bloquer rotation</span><span><span class="hud-key" id="shiftKey">Shift</span> + survol</span></div>
            <div class="hud-row"><span data-i18n="hud-paint">Peindre</span><span><span class="hud-key" id="spaceKey">Espace</span> + survol</span></div>
            <div class="hud-row"><span data-i18n="hud-erase-mode">Effacer</span><span><span class="hud-key" id="ctrlKey">Ctrl</span> + survol</span></div>
            <hr style="border: none; border-top: 1px solid rgba(255,255,255,.2); margin: 8px 0;">
            <div class="hud-row"><span data-i18n="hud-zoom">Zoom</span><span><span class="hud-key">Molette</span> / <span class="hud-key">Milieu</span></span></div>
            <div class="hud-row"><span data-i18n="hud-orbit">Orbiter</span><span><span class="hud-key" data-i18n="hud-orbit-key">Clic glissé</span></span></div>
            <div class="hud-row"><span data-i18n="hud-pan">Pan</span><span><span class="hud-key">Clic droit glissé</span></span></div>
            <div class="hud-row"><span data-i18n="hud-reset-key">Centrer vue</span><span><span class="hud-key">F</span></span></div>
            <div class="hud-row"><span data-i18n="hud-toggle-key">Perspective</span><span><span class="hud-key">P</span></span></div>
        </div>
        <div id="hud-layers">
            <div class="hud-title" data-i18n="layers-header">Groupes</div>
            <div id="layers-list" style="display:flex;flex-direction:column;gap:3px;max-height:150px;overflow-y:auto;margin-bottom:6px;"></div>
            <div style="display:flex;gap:4px;">
                <button id="newLayerBtn" class="btn" style="flex:1;font-size:.78em;padding:5px 6px;justify-content:center;">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    <span data-i18n="layer-new">Nouveau</span>
                </button>
                <button id="groupLayerBtn" class="btn" style="flex:1;font-size:.78em;padding:5px 6px;justify-content:center;" disabled>
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                    <span data-i18n="layer-group">Grouper</span>
                </button>
            </div>
        </div>
    </div>
</div>
        </div>
    </div>
</div>



<div id="about-panel">
    <div class="hud-title" data-i18n="details-title">À propos</div>
    <p data-i18n="details-origin">Le système <strong style="color:var(--text-main);">HSW</strong> a été créé par <strong style="color:var(--text-main);">@RostaP</strong> :</p>
    <p><a href="https://www.printables.com/model/152592-honeycomb-storage-wall" target="_blank" rel="noopener">Honeycomb Storage Wall</a></p>
    <p data-i18n="details-inspired" style="margin-top:6px;">Inspirations :</p>
    <p><a href="https://gridfinity.perplexinglabs.com/pr/hsw/0/0" target="_blank" rel="noopener">HSW Designer — perplexinglabs</a></p>
    <p><a href="https://www.printables.com/model/380870-customizable-honeycomb-storage-wall-openscad/files" target="_blank" rel="noopener">Customizable HSW — OpenSCAD</a></p>
    <hr style="border:none;border-top:1px solid var(--border);margin:8px 0;">
    <p data-i18n="details-legal" class="legal-text" style="font-size:.9em;line-height:1.5;">Cet outil fonctionne entièrement dans votre navigateur. Aucune donnée n'est collectée ni transmise à un serveur. Vos sessions sont sauvegardées localement. Les fichiers STL générés sont à usage personnel — vérifiez les dimensions avant impression.</p>
