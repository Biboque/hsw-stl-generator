function applyLang(lang) {
    currentLang = lang;
    document.querySelectorAll('[data-i18n]').forEach(el => { const k = el.getAttribute('data-i18n'); if (LANG[lang][k] !== undefined) el.innerHTML = LANG[lang][k]; });
    document.getElementById('langBtn').textContent = lang==='fr' ? 'EN' : 'FR';
}

window.toggleLang = () => applyLang(currentLang==='fr' ? 'en' : 'fr');

window.toggleBorder = () => {
    showBorder = !showBorder;
    document.getElementById('borderBtn').classList.toggle('active', showBorder);
    if (showBorder) { elements.forEach((mesh, sk) => { const type = elementTypes.get(sk); const { q, r } = mesh.userData; addBorderMesh(sk, type, q, r); }); }
    else { borderMeshes.forEach(m => { scene.remove(m); m.geometry.dispose(); }); borderMeshes.clear(); }
};

window.setTool = t => {
    activeTool = t;
    lockedOrientation.delete(t);
    const btnIds = ['addBtn','hexFullBtn','hexFixFullBtn','trapBtn','trapFullBtn','trapFixBtn','pentaBtn','pentaFullBtn','pentaFixBtn','quartBtn','quartFullBtn','quartFixBtn','triBtn','triFullBtn','triFixBtn','tiersBtn','tiersFullBtn','tiersFixBtn','diamondBtn','diamondFullBtn','diamondFixBtn','eclatBtn','eclatFullBtn','eclatFixBtn','removeBtn','selectBtn'];
    btnIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('active', id === t + 'Btn');
    });
    // Set data-tool attribute for custom cursors
    const cc = document.getElementById('canvas-container');
    if (cc) cc.setAttribute('data-tool', t);
    // Clear undo/redo stacks on tool change
    undoStack = [];
    redoStack = [];
    hidePreview();
};

window.setShoulder = dir => {
    shoulderDir = dir;
    const SHOULDER_INDEPENDENT = t => t==='hexFull' || t.startsWith('trapFull_') || t.startsWith('pentaFull_') || t.startsWith('quartFull_') || t.startsWith('triFull_') || t.startsWith('triFix_') || t.startsWith('tiersFull_');
    elements.forEach((mesh, sk) => { const t = elementTypes.get(sk); if (SHOULDER_INDEPENDENT(t)) return; mesh.geometry.dispose(); mesh.geometry = buildGeometry(t); });
    // Rebuild borders to reflect new shoulder direction
    if (showBorder) {
        borderMeshes.forEach(m => { scene.remove(m); m.geometry.dispose(); }); borderMeshes.clear();
        elements.forEach((mesh, sk) => { const t = elementTypes.get(sk); const { q, r } = mesh.userData; addBorderMesh(sk, t, q, r); });
    }
};

window.clearAll = () => {
    if (!elements.size || !confirm(LANG[currentLang]['confirm-clear'])) return;
    elements.forEach(m => scene.remove(m)); elements.clear(); elementTypes.clear();
    pieceToLayer.clear(); selectedPieces.clear(); clearAllHighlights();
    borderMeshes.forEach(m => { scene.remove(m); m.geometry.dispose(); }); borderMeshes.clear();
    layers.clear();
    layers.set('default', {
        name: 'Groupe 1',
        visible: true,
        locked: false,
        order: 0,
        color: new THREE.Color(0xf39c12)
    });
    activeLayerId = 'default';
    nextLayerId = 1;
    updateStats();
    renderLayersList();
    updateGroupBtn();
    try { localStorage.removeItem(SESSION_KEY); } catch(e) {}
    showSessionStatus('🗑 Session effacée');
};

window.exportSTL = () => {
    if (!elements.size) return;
    const s = new THREE.Scene();
    const clones = [];
    let visibleCount = 0;
    elements.forEach((m, sk) => {
        const lid = pieceToLayer.get(sk);
        const layer = lid ? layers.get(lid) : null;
        if (layer && !layer.visible) return;
        const c = m.clone(); clones.push(c); s.add(c);
        visibleCount++;
    });
    if (visibleCount === 0) return;
    borderMeshes.forEach((m, sk) => {
        const lid = pieceToLayer.get(sk);
        const layer = lid ? layers.get(lid) : null;
        if (layer && !layer.visible) return;
        const c = m.clone(); clones.push(c); s.add(c);
    });
    const date = new Date().toISOString().slice(0, 10);
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([new STLExporter().parse(s, {binary:true})], {type:'application/octet-stream'}));
    a.download = `hsw_design_${visibleCount}el_${date}.stl`;
    a.click();
    clones.forEach(c => { if (c.geometry) c.geometry.dispose(); if (c.material) c.material.dispose(); });
};

window.resetView = () => {
    let cx=0, cy=0;
    if (elements.size) { elements.forEach(m => { cx+=m.position.x; cy+=m.position.y; }); cx /= elements.size; cy /= elements.size; }
    const center = new THREE.Vector3(cx, cy, 0);
    controls.target.copy(center);
    if (isOrtho) { orthoCamera.position.set(cx, cy, 500); orthoCamera.lookAt(center); } else { camera.position.set(cx, cy, 280); camera.lookAt(center); }
    controls.update();
};

function updateOrthoSize(W, H) {
    const oh=280, asp=W/H; orthoCamera.left=-oh*asp; orthoCamera.right=oh*asp; orthoCamera.top=oh; orthoCamera.bottom=-oh; orthoCamera.updateProjectionMatrix();
}

window.toggleGrid = () => { gridVisible = !gridVisible; gridLines.forEach(l => l.visible=gridVisible); document.getElementById('gridToggleBtn').classList.toggle('active', !gridVisible); };

const VIEW_ICON_ISO = `<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"><polygon points="10,3 17,7 10,11 3,7" fill="rgba(255,255,255,0.06)"/><polygon points="3,7 10,11 10,17 3,13" fill="rgba(255,255,255,0.03)"/><polygon points="17,7 10,11 10,17 17,13" fill="rgba(255,255,255,0.09)"/></svg>`;
const VIEW_ICON_PERSP = `<svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"><rect x="6" y="6" width="7" height="7" fill="rgba(255,255,255,0.06)"/><polygon points="6,6 13,6 16,3 9,3" fill="rgba(255,255,255,0.09)"/><polygon points="13,6 16,3 16,10 13,13" fill="rgba(255,255,255,0.03)"/></svg>`;

window.toggleView = () => {
    isOrtho = !isOrtho; const btn = document.getElementById('viewToggleBtn');
    if (isOrtho) { orthoCamera.position.set(0, 0, 500); orthoCamera.lookAt(0, 0, 0); controls.object = orthoCamera; updateOrthoSize(window.innerWidth-300, window.innerHeight); btn.innerHTML = VIEW_ICON_PERSP; btn.classList.add('active'); }
    else { camera.position.set(0, 0, 280); controls.object = camera; btn.innerHTML = VIEW_ICON_ISO; btn.classList.remove('active'); }
    controls.target.set(0, 0, 0); controls.update();
};

function animate() {
    requestAnimationFrame(animate);
    controls.update();
    renderer.render(scene, isOrtho ? orthoCamera : camera);
}

function loadSession(session) {
    if (!session || !session.elements) return false;
    // Clear current state
    elements.forEach(m => scene.remove(m)); elements.clear(); elementTypes.clear();
    pieceToLayer.clear(); selectedPieces.clear();
    borderMeshes.forEach(m => { scene.remove(m); m.geometry.dispose(); }); borderMeshes.clear();
    // Restore settings
    if (session.lang && session.lang !== currentLang) applyLang(session.lang);
    if (session.shoulderDir) { shoulderDir = session.shoulderDir; }
    // Restore layers
    layers.clear();
    if (session.layers) {
        for (const [id, ld] of Object.entries(session.layers)) {
            layers.set(id, {
                name: ld.name,
                visible: ld.visible,
                locked: ld.locked,
                order: ld.order,
                color: new THREE.Color(ld.color)
            });
        }
    }
    // Ensure default layer exists
    if (!layers.has('default')) {
        layers.set('default', {
            name: 'Groupe 1',
            visible: true,
            locked: false,
            order: 0,
            color: new THREE.Color(0xf39c12)
        });
    }
    if (session.activeLayerId && layers.has(session.activeLayerId)) {
        activeLayerId = session.activeLayerId;
    } else {
        activeLayerId = 'default';
    }
    if (session.nextLayerId) nextLayerId = session.nextLayerId;
    // Restore elements with layer assignment
    session.elements.forEach(({ q, r, type, layerId }) => {
        const savedLayer = layerId && layers.has(layerId) ? layerId : 'default';
        const prevActiveLayer = activeLayerId;
        activeLayerId = savedLayer;
        placeElement(q, r, type);
        activeLayerId = prevActiveLayer;
    });
    // Restore border state
    if (session.showBorder !== showBorder) toggleBorder();
    updateStats();
    renderLayersList();
    return true;
}

window.saveSession = () => {
    try {
        localStorage.setItem(SESSION_KEY, JSON.stringify(serializeSession()));
        showSessionStatus('✓ Sauvegardé');
    } catch(e) {
        showSessionStatus('⚠ Erreur de sauvegarde', true);
    }
};

window.exportJSON = () => {
    const data = serializeSession();
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    const count = data.elements.length;
    a.href = URL.createObjectURL(blob);
    a.download = `hsw_design_${count}el_${new Date().toISOString().slice(0,10)}.json`;
    a.click();
    showSessionStatus('✓ JSON exporté');
};

window.importJSON = (event) => {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => {
        try {
            const session = JSON.parse(e.target.result);
            if (loadSession(session)) {
                showSessionStatus('✓ ' + session.elements.length + ' élément(s) chargé(s)');
            } else {
                showSessionStatus('⚠ Fichier invalide', true);
            }
        } catch(err) {
            showSessionStatus('⚠ Erreur de lecture', true);
        }
        // Reset input so same file can be re-imported
        event.target.value = '';
    };
    reader.readAsText(file);
};

function showSessionStatus(msg, isError = false) {
    const el = document.getElementById('session-status');
    if (!el) return;
    el.style.color = isError ? 'var(--danger)' : 'var(--accent)';
    el.textContent = msg;
    el.style.opacity = '1';
    clearTimeout(el._hideTimer);
    el._hideTimer = setTimeout(() => { el.style.opacity = '0'; }, 2500);
}

// Auto-save is handled by triggerAutoSave() defined above, called from updateStats()

// Default demo session
const defaultSession = {
