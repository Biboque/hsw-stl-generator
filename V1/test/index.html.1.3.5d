document.getElementById('mirrorXBtn').addEventListener('click', () => mirrorDesign('x'));
document.getElementById('mirrorYBtn').addEventListener('click', () => mirrorDesign('y'));
document.getElementById('mirrorZBtn').addEventListener('click', () => mirrorDesign('z'));
});
document.getElementById('borderBtn').addEventListener('click', () => toggleBorder());
document.getElementById('exportBtn').addEventListener('click', () => exportSTL());
