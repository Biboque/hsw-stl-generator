document.getElementById('triFixBtn')?.addEventListener('click', () => { try { setTool('triFix'); } catch(e) { console.error('triFixBtn error:', e); } });
document.getElementById('tiersBtn')?.addEventListener('click', () => { try { setTool('tiers'); } catch(e) { console.error('tiersBtn error:', e); } });
document.getElementById('tiersFullBtn')?.addEventListener('click', () => { try { setTool('tiersFull'); } catch(e) { console.error('tiersFullBtn error:', e); } });
document.getElementById('tiersFixBtn')?.addEventListener('click', () => { try { setTool('tiersFix'); } catch(e) { console.error('tiersFixBtn error:', e); } });
document.getElementById('diamondBtn')?.addEventListener('click', () => { console.log('diamondBtn clicked, setting tool to diamond'); try { setTool('diamond'); } catch(e) { console.error('diamondBtn error:', e); } });
