<script>
// CDN availability check — show a friendly error if Three.js fails to load
window.addEventListener('error', function(e) {
    if (e.filename && e.filename.includes('unpkg.com')) {
        document.body.insertAdjacentHTML('beforeend',
            '<div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#1e1e21;border:1px solid #c0392b;border-radius:8px;padding:24px 32px;color:#e0e0e0;font-family:Inter,sans-serif;text-align:center;z-index:9999;max-width:340px">' +
            '<div style="font-size:1.4em;margin-bottom:8px;">⚠️</div>' +
            '<strong style="color:#f39c12;">Erreur de chargement</strong>' +
            '<p style="margin:10px 0 4px;font-size:.88em;color:#88888c;">Impossible de charger Three.js depuis le CDN.<br>Vérifiez votre connexion internet.</p>' +
            '</div>');
    }
}, true);
</script>
<script type="importmap">{"imports":{"three":"https://unpkg.com/three@0.160.0/build/three.module.js","three/addons/":"https://unpkg.com/three@0.160.0/examples/jsm/"}}</script>
<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { STLExporter }   from 'three/addons/exporters/STLExporter.js';

// ─── Dimensions ──────────────────────────────────────────────────────────────
const HOLE_W   = 20;
const WALL     = 1.8;
const WALL_MIN = 0.8;
const DEPTH    = 8;
const H_STEP   = 2;
const HEX_H    = HOLE_W + WALL * 2;
const HEX_S    = HEX_H / Math.sqrt(3);
const INNER_S  = HOLE_W / Math.sqrt(3);
const DEG60    = Math.PI / 3;

function hexPts(r) {
    return Array.from({length:6}, (_,i) => new THREE.Vector2(r*Math.cos(i*DEG60), r*Math.sin(i*DEG60)));
}

// ─── Geometry helpers ────────────────────────────────────────────────────────
function mergeGeos(geos) {
    const positions=[], normals=[], indices=[];
    let offset = 0;
    for (const g of geos) {
        const pos = g.attributes.position.array;
        const nor = g.attributes.normal?.array;
        const idx = g.index?.array;
        positions.push(...pos);
        if (nor) normals.push(...nor);
        const cnt = pos.length / 3;
        if (idx) indices.push(...idx.map(i => i + offset));
        else     for (let i=0; i<cnt; i++) indices.push(i + offset);
        offset += cnt;
        g.dispose();
    }
    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(positions), 3));
    if (normals.length) geo.setAttribute('normal', new THREE.BufferAttribute(new Float32Array(normals), 3));
    geo.setIndex(indices);
    geo.computeVertexNormals();
    return geo;
}

function extrude(shape, depth, z=0) {
    const geo = new THREE.ExtrudeGeometry(shape, {depth, bevelEnabled:false});
    if (z) geo.translate(0, 0, z);
    return geo;
}

// Build two-layer shoulder: narrow slice + full slice, direction from `sb`
function shoulderPair(makeFn, sb) {
    const narrow = makeFn(INNER_S + (WALL - WALL_MIN));
    const full   = makeFn(INNER_S);
    return sb
        ? mergeGeos([narrow(H_STEP, 0),        full(DEPTH-H_STEP, H_STEP)])
        : mergeGeos([full(DEPTH-H_STEP, 0),    narrow(H_STEP, DEPTH-H_STEP)]);
}

// ─── Hexagone creux ──────────────────────────────────────────────────────────
function buildHexByCrown(sb=false) {
    const outer = hexPts(HEX_S);
    return shoulderPair(innerS => {
        const inner = hexPts(innerS);
        return (depth, z) => {
            const shape = new THREE.Shape(outer);
            const hole  = new THREE.Path();
            hole.moveTo(inner[0].x, inner[0].y);
            for (let i=5; i>=1; i--) hole.lineTo(inner[i].x, inner[i].y);
            hole.closePath();
            shape.holes.push(hole);
            return extrude(shape, depth, z);
        };
    }, sb);
}

// ─── Trapèze creux ───────────────────────────────────────────────────────────
function buildTrapGeometry(angle, sb=false) {
    const ext = hexPts(HEX_S);
    const geo = shoulderPair(innerS => {
        const inn = hexPts(innerS);
        const wOff = WALL - (innerS - INNER_S); // shoulder-aware offset for the flat face (inverted: narrow layer → thin wall)
        return (depth, z) => {
            const s = new THREE.Shape();
            s.moveTo(ext[0].x,ext[0].y); s.lineTo(ext[1].x,ext[1].y);
            s.lineTo(ext[2].x,ext[2].y); s.lineTo(ext[3].x,ext[3].y);
            s.lineTo(ext[0].x,ext[3].y); s.closePath();
            const hy = ext[3].y + wOff;
            const h = new THREE.Path();
            h.moveTo(inn[0].x-wOff/2,hy); h.lineTo(inn[3].x+wOff/2,hy);
            h.lineTo(inn[2].x,inn[2].y);  h.lineTo(inn[1].x,inn[1].y);
            h.lineTo(inn[0].x,inn[0].y);  h.closePath();
            s.holes.push(h);
            return extrude(s, depth, z);
        };
    }, sb);
    if (angle) geo.rotateZ(angle);
    return geo;
}

// ─── Trapèze fixation (fraisage conique) ─────────────────────────────────────
function buildTrapFixGeometry(angle, sb=false) {
    const ext    = hexPts(HEX_S);
    const holeY  = (ext[1].y + ext[0].y) / 2;
    const shaftR = 1.6, cskR = 5.0, cskDepth = 4.5;
    const shaftDepth = DEPTH - cskDepth;
    const CSK_LAYERS = 12;

    function trapWithHole(r) {
        const s = new THREE.Shape();
        s.moveTo(ext[0].x,ext[0].y); s.lineTo(ext[1].x,ext[1].y);
        s.lineTo(ext[2].x,ext[2].y); s.lineTo(ext[3].x,ext[3].y);
        s.lineTo(ext[0].x,ext[3].y); s.closePath();
        const h = new THREE.Path();
        h.absarc(0, holeY, r, 0, Math.PI*2, true);
        s.holes.push(h);
        return s;
    }

    function coneSlices(fromR, toR, zStart) {
        return Array.from({length: CSK_LAYERS}, (_, i) => {
            const t  = i / CSK_LAYERS;
            const r  = fromR + (toR-fromR)*t;
            return extrude(trapWithHole(r), cskDepth/CSK_LAYERS, zStart + t*cskDepth);
        });
    }

    const geos = sb
        ? [extrude(trapWithHole(shaftR), shaftDepth, 0),        ...coneSlices(shaftR, cskR, shaftDepth)]
        : [...coneSlices(cskR, shaftR, 0), extrude(trapWithHole(shaftR), shaftDepth, cskDepth)];

    const geo = mergeGeos(geos);
    if (angle) geo.rotateZ(angle);
    return geo;
}

// ─── Hexagone plein ──────────────────────────────────────────────────────────
function buildHexFullGeometry() {
    const outer = hexPts(HEX_S);
    const shape = new THREE.Shape(outer);
    return new THREE.ExtrudeGeometry(shape, {depth: DEPTH, bevelEnabled: false});
}

// ─── Hexagone plein avec fixation (fraisage conique centré) ──────────────────
function buildHexFixFullGeometry(sb=false) {
    const ext = hexPts(HEX_S);
    const shaftR = 1.6, cskR = 5.0, cskDepth = 4.5;
    const shaftDepth = DEPTH - cskDepth;
    const CSK_LAYERS = 12;

    function hexWithHole(r) {
        const s = new THREE.Shape(ext);
        const h = new THREE.Path();
        h.absarc(0, 0, r, 0, Math.PI*2, true);
        s.holes.push(h);
        return s;
    }

    function coneSlices(fromR, toR, zStart) {
        return Array.from({length: CSK_LAYERS}, (_, i) => {
            const t  = i / CSK_LAYERS;
            const r  = fromR + (toR-fromR)*t;
            return extrude(hexWithHole(r), cskDepth/CSK_LAYERS, zStart + t*cskDepth);
        });
    }

    const geos = sb
        ? [extrude(hexWithHole(shaftR), shaftDepth, 0),        ...coneSlices(shaftR, cskR, shaftDepth)]
        : [...coneSlices(cskR, shaftR, 0), extrude(hexWithHole(shaftR), shaftDepth, cskDepth)];

    return mergeGeos(geos);
}

// ─── Trapèze plein (sans découpe intérieure) ─────────────────────────────────
function buildTrapFullGeometry(angle) {
    const ext = hexPts(HEX_S);
    const s = new THREE.Shape();
    s.moveTo(ext[0].x,ext[0].y); s.lineTo(ext[1].x,ext[1].y);
    s.lineTo(ext[2].x,ext[2].y); s.lineTo(ext[3].x,ext[3].y);
    s.lineTo(ext[0].x,ext[3].y); s.closePath();
    const geo = new THREE.ExtrudeGeometry(s, {depth: DEPTH, bevelEnabled: false});
    if (angle) geo.rotateZ(angle);
    return geo;
}

// sector s (0–5) → rotation angle in radians  [s=1=top=0, s=4=bottom=π]
function sectorAngle(s) { return (s - 1) * Math.PI / 3; }

// ─── Pentagone creux ─────────────────────────────────────────────────────────
function buildPentaGeometry(corner, sb=false) {
    const ext = hexPts(HEX_S);
    const geo = shoulderPair(innerS => {
        const inn = hexPts(innerS);
        const wOff = WALL - (innerS - INNER_S); // shoulder-aware offset for the flat face (inverted: narrow layer → thin wall)
        return (depth, z) => {
            const s = new THREE.Shape();
            s.moveTo(0,        ext[1].y);
            s.lineTo(ext[1].x, ext[1].y);
            s.lineTo(ext[0].x, ext[0].y);
            s.lineTo(ext[5].x, ext[5].y);
            s.lineTo(0,        ext[5].y);
            s.closePath();
            const h = new THREE.Path();
            h.moveTo(wOff,     inn[5].y);
            h.lineTo(inn[5].x, inn[5].y);
            h.lineTo(inn[0].x, inn[0].y);
            h.lineTo(inn[1].x, inn[1].y);
            h.lineTo(wOff,     inn[1].y);
            h.closePath();
            s.holes.push(h);
            return extrude(s, depth, z);
        };
    }, sb);
    geo.rotateZ(corner * DEG60);
    return geo;
}

// ─── Pentagone plein ──────────────────────────────────────────────────────────
function buildPentaFullGeometry(corner) {
    const ext = hexPts(HEX_S);
    const cutX = 0;
    const s = new THREE.Shape();
    s.moveTo(cutX,      ext[1].y);
    s.lineTo(ext[1].x,  ext[1].y);
    s.lineTo(ext[0].x,  ext[0].y);
    s.lineTo(ext[5].x,  ext[5].y);
    s.lineTo(cutX,      ext[5].y);
    s.closePath();
    const geo = new THREE.ExtrudeGeometry(s, {depth: DEPTH, bevelEnabled: false});
    geo.rotateZ(corner * DEG60);
    return geo;
}

// ─── Pentagone fixation ───────────────────────────────────────────────────────
function buildPentaFixGeometry(corner, sb=false) {
    const ext = hexPts(HEX_S);
    const cutX = 0;
    const shaftR = 1.6, cskR = 4.5, cskDepth = 4.5;
    const shaftDepth = DEPTH - cskDepth;
    const CSK_LAYERS = 12;
    const hx = (cutX + ext[1].x + ext[0].x + ext[5].x + cutX) / 5;
    const hy = (ext[1].y + ext[1].y + ext[0].y + ext[5].y + ext[5].y) / 5;

    function pentaWithHole(r) {
        const s = new THREE.Shape();
        s.moveTo(cutX,      ext[1].y);
        s.lineTo(ext[1].x,  ext[1].y);
        s.lineTo(ext[0].x,  ext[0].y);
        s.lineTo(ext[5].x,  ext[5].y);
        s.lineTo(cutX,      ext[5].y);
        s.closePath();
        const h = new THREE.Path();
        h.absarc(hx, hy, r, 0, Math.PI*2, false);
        s.holes.push(h);
        return s;
    }

    function coneSlices(fromR, toR, zStart) {
        return Array.from({length: CSK_LAYERS}, (_, i) => {
            const t = i / CSK_LAYERS;
            const r = fromR + (toR-fromR)*t;
            return extrude(pentaWithHole(r), cskDepth/CSK_LAYERS, zStart + t*cskDepth);
        });
    }

    const geos = sb
        ? [extrude(pentaWithHole(shaftR), shaftDepth, 0), ...coneSlices(shaftR, cskR, shaftDepth)]
        : [...coneSlices(cskR, shaftR, 0), extrude(pentaWithHole(shaftR), shaftDepth, cskDepth)];

    const geo = mergeGeos(geos);
    geo.rotateZ(corner * DEG60);
    return geo;
}

// ─── Quart d’hex (1/4 de cellule, 4 orientations) ────────────────────────────
function makeQuartOuterShape(ext, q) {
    const s = new THREE.Shape();
    if (q === 0) {
        s.moveTo(0, 0); s.lineTo(ext[0].x, ext[0].y); s.lineTo(ext[1].x, ext[1].y); s.lineTo(0, ext[1].y);
    } else if (q === 1) {
        s.moveTo(0, ext[1].y); s.lineTo(-ext[1].x, ext[1].y); s.lineTo(-ext[0].x, ext[0].y); s.lineTo(0, 0);
    } else if (q === 2) {
        s.moveTo(0, 0); s.lineTo(-ext[0].x, -ext[0].y); s.lineTo(-ext[1].x, -ext[1].y); s.lineTo(0, -ext[1].y);
    } else {
        s.moveTo(0, -ext[1].y); s.lineTo(ext[1].x, -ext[1].y); s.lineTo(ext[0].x, -ext[0].y); s.lineTo(0, 0);
    }
    s.closePath();
    return s;
}

function makeQuartHolePath(inn, q, wOff=WALL) {
    const hy = wOff;
    const h = new THREE.Path();
    if (q === 0) {
        h.moveTo(inn[0].x - wOff / 2, hy); h.lineTo(wOff, hy); h.lineTo(wOff, inn[1].y); h.lineTo(inn[1].x, inn[1].y); h.lineTo(inn[0].x, inn[0].y);
    } else if (q === 1) {
        h.moveTo(-inn[0].x, inn[0].y); h.lineTo(-inn[1].x, inn[1].y); h.lineTo(-wOff, inn[1].y); h.lineTo(-wOff, hy); h.lineTo(-(inn[0].x - wOff / 2), hy);
    } else if (q === 2) {
        h.moveTo(-(inn[0].x - wOff / 2), -hy); h.lineTo(-wOff, -hy); h.lineTo(-wOff, -inn[1].y); h.lineTo(-inn[1].x, -inn[1].y); h.lineTo(-inn[0].x, -inn[0].y);
    } else {
        h.moveTo(inn[0].x - wOff / 2, -hy); h.lineTo(wOff, -hy); h.lineTo(wOff, -inn[1].y); h.lineTo(inn[1].x, -inn[1].y); h.lineTo(inn[0].x, -inn[0].y);
    }
    h.closePath();
    return h;
}

function quartFixCenter(ext, q) {
    const w = (x, y) => { if (q === 0) return { x, y }; if (q === 1) return { x: -x, y }; if (q === 2) return { x: -x, y: -y }; return { x, y: -y }; };
    const p = [w(0, 0), w(ext[0].x, ext[0].y), w(ext[1].x, ext[1].y), w(0, ext[1].y)];
    const INWARD = 0.82;
    return { x: (p[0].x + p[1].x + p[2].x + p[3].x) / 4 * INWARD, y: (p[0].y + p[1].y + p[2].y + p[3].y) / 4 * INWARD };
}

function buildQuartGeometry(q, sb=false) {
    const ext = hexPts(HEX_S);
    const geo = shoulderPair(innerS => {
        const inn = hexPts(innerS);
        const wOff = WALL - (innerS - INNER_S); // shoulder-aware offset for both perpendicular faces (inverted: narrow layer → thin wall)
        return (depth, z) => {
            const s = makeQuartOuterShape(ext, q);
            s.holes.push(makeQuartHolePath(inn, q, wOff));
            return extrude(s, depth, z);
        };
    }, sb);
    return geo;
}

function buildQuartFullGeometry(q) {
    const ext = hexPts(HEX_S);
    const s = makeQuartOuterShape(ext, q);
    return new THREE.ExtrudeGeometry(s, {depth: DEPTH, bevelEnabled: false});
}

function buildQuartFixGeometry(q, sb=false) {
    const ext = hexPts(HEX_S);
    const shaftR = 1.6, cskR = 4.8, cskDepth = 4.2;
    const shaftDepth = DEPTH - cskDepth;
    const CSK_LAYERS = 12;
    const { x: fcx, y: fcy } = quartFixCenter(ext, q);

    function distPointToSegment(px, py, ax, ay, bx, by) {
        const vx = bx - ax, vy = by - ay, wx = px - ax, wy = py - ay;
        const vv = vx * vx + vy * vy;
        const t = vv ? Math.max(0, Math.min(1, (wx * vx + wy * vy) / vv)) : 0;
        return Math.hypot(px - (ax + t * vx), py - (ay + t * vy));
    }

    function quartOuterQuad(ext, q) {
        if (q === 0) return [{ x: 0, y: 0 }, { x: ext[0].x, y: ext[0].y }, { x: ext[1].x, y: ext[1].y }, { x: 0, y: ext[1].y }];
        if (q === 1) return [{ x: 0, y: ext[1].y }, { x: -ext[1].x, y: ext[1].y }, { x: -ext[0].x, y: ext[0].y }, { x: 0, y: 0 }];
        if (q === 2) return [{ x: 0, y: 0 }, { x: -ext[0].x, y: -ext[0].y }, { x: -ext[1].x, y: -ext[1].y }, { x: 0, y: -ext[1].y }];
        return [{ x: 0, y: -ext[1].y }, { x: ext[1].x, y: -ext[1].y }, { x: ext[0].x, y: -ext[0].y }, { x: 0, y: 0 }];
    }

    const qOuter = quartOuterQuad(ext, q);
    let minDist = Infinity;
    for (let i = 0; i < qOuter.length; i++) {
        const a = qOuter[i], b = qOuter[(i + 1) % qOuter.length];
        minDist = Math.min(minDist, distPointToSegment(fcx, fcy, a.x, a.y, b.x, b.y));
    }
    const margin = 0.25;
    const maxHoleR = Math.max(0.1, minDist - margin);
    const shaftR2 = Math.min(shaftR, maxHoleR);
    const cskR2 = Math.min(cskR, maxHoleR);

    function quartWithHole(r) {
        const s = makeQuartOuterShape(ext, q);
        const h = new THREE.Path();
        h.absarc(fcx, fcy, r, 0, Math.PI * 2, false);
        s.holes.push(h);
        return s;
    }

    function coneSlices(fromR, toR, zStart) {
        return Array.from({length: CSK_LAYERS}, (_, i) => {
            const t = i / CSK_LAYERS;
            const rad = fromR + (toR - fromR) * t;
            return extrude(quartWithHole(Math.min(rad, maxHoleR)), cskDepth / CSK_LAYERS, zStart + t * cskDepth);
        });
    }

    const geos = sb
        ? [extrude(quartWithHole(shaftR2), shaftDepth, 0), ...coneSlices(shaftR2, cskR2, shaftDepth)]
        : [...coneSlices(cskR2, shaftR2, 0), extrude(quartWithHole(shaftR2), shaftDepth, cskDepth)];

    return mergeGeos(geos);
}

// ─── Triangle (1/6 d'hexagone) ────────────────────────────────────────────────
// Triangle t : centre (0,0), ext[t], ext[(t+1)%6]
// Les 3 côtés : 2 côtés radiaux (interne) + 1 côté externe (arête hex)

function triOuterLocal(t) {
    const ext = hexPts(HEX_S);
    return [{ x: 0, y: 0 }, { x: ext[t].x, y: ext[t].y }, { x: ext[(t+1)%6].x, y: ext[(t+1)%6].y }];
}

function buildTriGeometry(t, sb=false) {
    const ext = hexPts(HEX_S);
    const geo = shoulderPair(innerS => {
        const inn = hexPts(innerS);
        const wOff = WALL - (innerS - INNER_S);
        return (depth, z) => {
            // Outer triangle
            const s = new THREE.Shape();
            s.moveTo(0, 0);
            s.lineTo(ext[t].x, ext[t].y);
            s.lineTo(ext[(t+1)%6].x, ext[(t+1)%6].y);
            s.closePath();
            // Inner hole: shrink each side by wOff
            // Compute inset triangle
            const A = { x: 0, y: 0 };
            const B = { x: ext[t].x, y: ext[t].y };
            const C = { x: ext[(t+1)%6].x, y: ext[(t+1)%6].y };
            const inset = insetTriangle(A, B, C, wOff);
            if (inset) {
                const h = new THREE.Path();
                h.moveTo(inset[0].x, inset[0].y);
                h.lineTo(inset[1].x, inset[1].y);
                h.lineTo(inset[2].x, inset[2].y);
                h.closePath();
                s.holes.push(h);
            }
            return extrude(s, depth, z);
        };
    }, sb);
    return geo;
}

function buildTriFullGeometry(t) {
    const ext = hexPts(HEX_S);
    const s = new THREE.Shape();
    s.moveTo(0, 0);
    s.lineTo(ext[t].x, ext[t].y);
    s.lineTo(ext[(t+1)%6].x, ext[(t+1)%6].y);
    s.closePath();
    return new THREE.ExtrudeGeometry(s, { depth: DEPTH, bevelEnabled: false });
}

function buildTriFixGeometry(t, sb=false) {
    const ext = hexPts(HEX_S);
    const shaftR = 1.6, cskR = 3.5, cskDepth = 4.5;
    const shaftDepth = DEPTH - cskDepth;
    const CSK_LAYERS = 12;
    // True centroid of triangle with vertices (0,0), ext[t], ext[(t+1)%6]
    const cx = (ext[t].x + ext[(t+1)%6].x) / 3;
    const cy = (ext[t].y + ext[(t+1)%6].y) / 3;

    function triWithHole(r) {
        const s = new THREE.Shape();
        s.moveTo(0, 0);
        s.lineTo(ext[t].x, ext[t].y);
        s.lineTo(ext[(t+1)%6].x, ext[(t+1)%6].y);
        s.closePath();
        const h = new THREE.Path();
        h.absarc(cx, cy, r, 0, Math.PI * 2, false);
        s.holes.push(h);
        return s;
    }

    function coneSlices(fromR, toR, zStart) {
        return Array.from({ length: CSK_LAYERS }, (_, i) => {
            const tt = i / CSK_LAYERS;
            const r = fromR + (toR - fromR) * tt;
            return extrude(triWithHole(r), cskDepth / CSK_LAYERS, zStart + tt * cskDepth);
        });
    }

    const geos = sb
        ? [extrude(triWithHole(shaftR), shaftDepth, 0), ...coneSlices(shaftR, cskR, shaftDepth)]
        : [...coneSlices(cskR, shaftR, 0), extrude(triWithHole(shaftR), shaftDepth, cskDepth)];
    return mergeGeos(geos);
}

// Inset a triangle ABC by offset d (toward centroid)
function insetTriangle(A, B, C, d) {
    function offsetEdge(P1, P2, offset) {
        const ex = P2.x - P1.x, ey = P2.y - P1.y;
        const len = Math.hypot(ex, ey);
        if (len < 1e-9) return null;
        return { nx: ey / len * offset, ny: -ex / len * offset };
    }
    function lineIntersect(p1, d1, p2, d2) {
        const denom = d1.dx * d2.dy - d1.dy * d2.dx;
        if (Math.abs(denom) < 1e-12) return null;
        const t = ((p2.x - p1.x) * d2.dy - (p2.y - p1.y) * d2.dx) / denom;
        return { x: p1.x + t * d1.dx, y: p1.y + t * d1.dy };
    }
    // centroid to determine inward direction
    const gx = (A.x + B.x + C.x) / 3, gy = (A.y + B.y + C.y) / 3;
    const edges = [[A,B],[B,C],[C,A]];
    const offsets = edges.map(([P1,P2]) => {
        const n = offsetEdge(P1, P2, d);
        if (!n) return null;
        // check direction toward centroid
        const mid = { x: (P1.x+P2.x)/2, y: (P1.y+P2.y)/2 };
        const toCent = { x: gx - mid.x, y: gy - mid.y };
        const dot = n.nx * toCent.x + n.ny * toCent.y;
        const sign = dot >= 0 ? 1 : -1;
        return { P1: { x: P1.x + n.nx*sign, y: P1.y + n.ny*sign }, P2: { x: P2.x + n.nx*sign, y: P2.y + n.ny*sign }, dx: P2.x-P1.x, dy: P2.y-P1.y };
    });
    if (offsets.some(o => !o)) return null;
    const pts = [
        lineIntersect(offsets[2].P1, {dx:offsets[2].dx,dy:offsets[2].dy}, offsets[0].P1, {dx:offsets[0].dx,dy:offsets[0].dy}),
        lineIntersect(offsets[0].P1, {dx:offsets[0].dx,dy:offsets[0].dy}, offsets[1].P1, {dx:offsets[1].dx,dy:offsets[1].dy}),
        lineIntersect(offsets[1].P1, {dx:offsets[1].dx,dy:offsets[1].dy}, offsets[2].P1, {dx:offsets[2].dx,dy:offsets[2].dy}),
    ];
    if (pts.some(p => !p)) return null;
    // Validate inset doesn't degenerate
    const area = Math.abs((pts[1].x-pts[0].x)*(pts[2].y-pts[0].y) - (pts[2].x-pts[0].x)*(pts[1].y-pts[0].y)) * 0.5;
    if (area < 0.5) return null;
    return pts;
}

// ─── Tiers (1/3 d'hexagone = 2 triangles fusionnés) ─────────────────────────
// Tiers t : centre (0,0), ext[t], ext[(t+1)%6], ext[(t+2)%6]
// Forme losange/diamant, 6 orientations, 3 paires symétriques

function tiersOuterLocal(t) {
    const ext = hexPts(HEX_S);
    return [
        { x: 0, y: 0 },
        { x: ext[t].x, y: ext[t].y },
        { x: ext[(t+1)%6].x, y: ext[(t+1)%6].y },
        { x: ext[(t+2)%6].x, y: ext[(t+2)%6].y }
    ];
}

function buildTiersGeometry(t, sb=false) {
    const ext = hexPts(HEX_S);
    const geo = shoulderPair(innerS => {
        const inn = hexPts(innerS);
        const wOff = WALL - (innerS - INNER_S);
        return (depth, z) => {
            const s = new THREE.Shape();
            s.moveTo(0, 0);
            s.lineTo(ext[t].x, ext[t].y);
            s.lineTo(ext[(t+1)%6].x, ext[(t+1)%6].y);
            s.lineTo(ext[(t+2)%6].x, ext[(t+2)%6].y);
            s.closePath();
            // Inset quadrilateral hole
            const A = { x: 0, y: 0 };
            const B = { x: ext[t].x, y: ext[t].y };
            const C = { x: ext[(t+1)%6].x, y: ext[(t+1)%6].y };
            const D = { x: ext[(t+2)%6].x, y: ext[(t+2)%6].y };
            const inset = insetQuad(A, B, C, D, wOff);
            if (inset) {
                const h = new THREE.Path();
                h.moveTo(inset[0].x, inset[0].y);
                h.lineTo(inset[1].x, inset[1].y);
                h.lineTo(inset[2].x, inset[2].y);
                h.lineTo(inset[3].x, inset[3].y);
                h.closePath();
                s.holes.push(h);
            }
            return extrude(s, depth, z);
        };
    }, sb);
    return geo;
}

function buildTiersFullGeometry(t) {
    const ext = hexPts(HEX_S);
    const s = new THREE.Shape();
    s.moveTo(0, 0);
    s.lineTo(ext[t].x, ext[t].y);
    s.lineTo(ext[(t+1)%6].x, ext[(t+1)%6].y);
    s.lineTo(ext[(t+2)%6].x, ext[(t+2)%6].y);
    s.closePath();
    return new THREE.ExtrudeGeometry(s, { depth: DEPTH, bevelEnabled: false });
}

function buildTiersFixGeometry(t, sb=false) {
    const ext = hexPts(HEX_S);
    const shaftR = 1.6, cskR = 5.0, cskDepth = 4.5;
    const shaftDepth = DEPTH - cskDepth;
    const CSK_LAYERS = 12;
    // True centroid = average of all 4 vertices (including origin)
    const fcx = (0 + ext[t].x + ext[(t+1)%6].x + ext[(t+2)%6].x) / 4;
    const fcy = (0 + ext[t].y + ext[(t+1)%6].y + ext[(t+2)%6].y) / 4;

    function tiersWithHole(r) {
        const s = new THREE.Shape();
        s.moveTo(0, 0);
        s.lineTo(ext[t].x, ext[t].y);
        s.lineTo(ext[(t+1)%6].x, ext[(t+1)%6].y);
        s.lineTo(ext[(t+2)%6].x, ext[(t+2)%6].y);
        s.closePath();
        const h = new THREE.Path();
        h.absarc(fcx, fcy, r, 0, Math.PI * 2, false);
        s.holes.push(h);
        return s;
    }

    function coneSlices(fromR, toR, zStart) {
        return Array.from({ length: CSK_LAYERS }, (_, i) => {
            const tt = i / CSK_LAYERS;
            const r = fromR + (toR - fromR) * tt;
            return extrude(tiersWithHole(r), cskDepth / CSK_LAYERS, zStart + tt * cskDepth);
        });
    }

    const geos = sb
        ? [extrude(tiersWithHole(shaftR), shaftDepth, 0), ...coneSlices(shaftR, cskR, shaftDepth)]
        : [...coneSlices(cskR, shaftR, 0), extrude(tiersWithHole(shaftR), shaftDepth, cskDepth)];
    return mergeGeos(geos);
}

// Inset a convex quadrilateral ABCD by offset d (toward centroid)
function insetQuad(A, B, C, D, d) {
    const pts = [A, B, C, D];
    const n = pts.length;
    const gx = pts.reduce((s,p) => s+p.x, 0)/n;
    const gy = pts.reduce((s,p) => s+p.y, 0)/n;

    const offEdges = pts.map((P1, i) => {
        const P2 = pts[(i+1)%n];
        const ex = P2.x-P1.x, ey = P2.y-P1.y;
        const len = Math.hypot(ex, ey);
        if (len < 1e-9) return null;
        let nx = ey/len, ny = -ex/len;
        const mid = { x:(P1.x+P2.x)/2, y:(P1.y+P2.y)/2 };
        if (nx*(gx-mid.x)+ny*(gy-mid.y) < 0) { nx=-nx; ny=-ny; }
        return { P1:{x:P1.x+nx*d, y:P1.y+ny*d}, dx:ex, dy:ey };
    });
    if (offEdges.some(e => !e)) return null;

    const result = offEdges.map((e1, i) => {
        const e2 = offEdges[(i+1)%n];
        const denom = e1.dx*e2.dy - e1.dy*e2.dx;
        if (Math.abs(denom) < 1e-12) return null;
        const t = ((e2.P1.x-e1.P1.x)*e2.dy - (e2.P1.y-e1.P1.y)*e2.dx) / denom;
        return { x: e1.P1.x + t*e1.dx, y: e1.P1.y + t*e1.dy };
    });
    if (result.some(p => !p)) return null;

    let area = 0;
    for (let i=0; i<n; i++) { const j=(i+1)%n; area += result[i].x*result[j].y - result[j].x*result[i].y; }
    if (Math.abs(area)*0.5 < 1.0) return null;
    return result;
}

// Inset a convex polygon by offset d (toward centroid) - no min area check
function insetPolyNoMinArea(pts, d) {
    const n = pts.length;
    const gx = pts.reduce((s,p) => s+p.x, 0)/n;
    const gy = pts.reduce((s,p) => s+p.y, 0)/n;

    const offEdges = pts.map((P1, i) => {
        const P2 = pts[(i+1)%n];
        const ex = P2.x-P1.x, ey = P2.y-P1.y;
        const len = Math.hypot(ex, ey);
        if (len < 1e-9) return null;
        let nx = ey/len, ny = -ex/len;
        const mid = { x:(P1.x+P2.x)/2, y:(P1.y+P2.y)/2 };
        if (nx*(gx-mid.x)+ny*(gy-mid.y) < 0) { nx=-nx; ny=-ny; }
        return { P1:{x:P1.x+nx*d, y:P1.y+ny*d}, dx:ex, dy:ey };
    });
    if (offEdges.some(e => !e)) return null;

    const result = offEdges.map((e1, i) => {
        const e2 = offEdges[(i+1)%n];
        const denom = e1.dx*e2.dy - e1.dy*e2.dx;
        if (Math.abs(denom) < 1e-12) {
            // Fallback for near-parallel edges: use midpoint
            return { x: (e1.P1.x + e2.P1.x)/2, y: (e1.P1.y + e2.P1.y)/2 };
        }
        const t = ((e2.P1.x-e1.P1.x)*e2.dy - (e2.P1.y-e1.P1.y)*e2.dx) / denom;
        return { x: e1.P1.x + t*e1.dx, y: e1.P1.y + t*e1.dy };
    });
    return result; // Always return result, even if some intersections failed
}

// Inset a convex polygon by offset d (toward centroid)
function insetPoly(pts, d, minArea=1.0) {
    const n = pts.length;
    const gx = pts.reduce((s,p) => s+p.x, 0)/n;
    const gy = pts.reduce((s,p) => s+p.y, 0)/n;

    const offEdges = pts.map((P1, i) => {
        const P2 = pts[(i+1)%n];
        const ex = P2.x-P1.x, ey = P2.y-P1.y;
        const len = Math.hypot(ex, ey);
        if (len < 1e-9) return null;
        let nx = ey/len, ny = -ex/len;
        const mid = { x:(P1.x+P2.x)/2, y:(P1.y+P2.y)/2 };
        if (nx*(gx-mid.x)+ny*(gy-mid.y) < 0) { nx=-nx; ny=-ny; }
        return { P1:{x:P1.x+nx*d, y:P1.y+ny*d}, dx:ex, dy:ey };
    });
    if (offEdges.some(e => !e)) return null;

    const result = offEdges.map((e1, i) => {
        const e2 = offEdges[(i+1)%n];
        const denom = e1.dx*e2.dy - e1.dy*e2.dx;
        if (Math.abs(denom) < 1e-12) return null;
        const t = ((e2.P1.x-e1.P1.x)*e2.dy - (e2.P1.y-e1.P1.y)*e2.dx) / denom;
        return { x: e1.P1.x + t*e1.dx, y: e1.P1.y + t*e1.dy };
    });
    if (result.some(p => !p)) return null;

    let area = 0;
    for (let i=0; i<n; i++) { const j=(i+1)%n; area += result[i].x*result[j].y - result[j].x*result[i].y; }
    if (Math.abs(area)*0.5 < minArea) return null;
    return result;
}

// ─── Diamant (z1-z4 = 30°-150°, 120° sector) ────────────────────────────────
// Diamond shape: quadrilateral from center through hex boundary at 30°, 90°, 150°
// Vertices: center(0,0), pt@30°, pt@90°, pt@150° on hex boundary

function getHexBoundaryPt(angle, r) {
    // Get point on hex boundary at given angle
    let a = angle % (2 * Math.PI);
    if (a < 0) a += 2 * Math.PI;
    const sector = Math.floor(a / DEG60);
    const corners = hexPts(r);
    const v1 = corners[sector];
    const v2 = corners[(sector + 1) % 6];
    const t = (a - sector * DEG60) / DEG60;
    return { x: v1.x + (v2.x - v1.x) * t, y: v1.y + (v2.y - v1.y) * t };
}

function diamondOuterLocal(angle=0) {
    // Diamond spans z1-z4 = 30°-150° (4 zones = 120°)
    // Vertices: center, 30° on edge, corner 1 (60°), 90° on edge, corner 2 (120°), 150° on edge
    const ext = hexPts(HEX_S);
    const p30 = getHexBoundaryPt((30 + angle) * Math.PI / 180, HEX_S);
    const p90 = getHexBoundaryPt((90 + angle) * Math.PI / 180, HEX_S);
    const p150 = getHexBoundaryPt((150 + angle) * Math.PI / 180, HEX_S);
    // z1-z4 = corner 0->1->2->3 boundaries, but with intermediate points
    // Rotate the corner points by angle
    const c1 = rotPoly([{ x: ext[1].x, y: ext[1].y }], angle * Math.PI / 180)[0];
    const c2 = rotPoly([{ x: ext[2].x, y: ext[2].y }], angle * Math.PI / 180)[0];
    return [
        { x: 0, y: 0 },       // center
        p30,                  // 30° on edge (boundary z0/z1)
        c1,                   // corner 1 = 60° (boundary z1/z2)
        p90,                  // 90° on edge (boundary z2/z3)
        c2,                   // corner 2 = 120° (boundary z3/z4)
        p150                  // 150° on edge (boundary z4/z5)
    ];
}

function diamondInnerLocal(angle=0) {
    // Same as outer but scaled to inner size
    const outer = diamondOuterLocal(angle);
    const scale = INNER_S / HEX_S;
    return outer.map(p => ({ x: p.x * scale, y: p.y * scale }));
}

function buildDiamondGeometry(angle=0, sb=false) {
    const outer = diamondOuterLocal(angle);
    const geo = shoulderPair(innerS => {
        const wOff = WALL - (innerS - INNER_S);
        return (depth, z) => {
            const s = new THREE.Shape();
            s.moveTo(outer[0].x, outer[0].y);
            s.lineTo(outer[1].x, outer[1].y);
            s.lineTo(outer[2].x, outer[2].y);
            s.lineTo(outer[3].x, outer[3].y);
            s.lineTo(outer[4].x, outer[4].y);
            s.lineTo(outer[5].x, outer[5].y);
            s.closePath();
            // Use insetPolyNoMinArea for diamond shape
            const inset = insetPolyNoMinArea(outer, wOff);
            if (inset && inset.length > 0) {
                const h = new THREE.Path();
                h.moveTo(inset[0].x, inset[0].y);
                for (let i = 1; i < inset.length; i++) {
                    h.lineTo(inset[i].x, inset[i].y);
                }
                h.closePath();
                s.holes.push(h);
            }
            return extrude(s, depth, z);
        };
    }, sb);
    return geo;
}

function buildDiamondFullGeometry(angle=0) {
    const outer = diamondOuterLocal(angle);
    const s = new THREE.Shape();
    s.moveTo(outer[0].x, outer[0].y);
    s.lineTo(outer[1].x, outer[1].y);
    s.lineTo(outer[2].x, outer[2].y);
    s.lineTo(outer[3].x, outer[3].y);
    s.lineTo(outer[4].x, outer[4].y);
    s.lineTo(outer[5].x, outer[5].y);
    s.closePath();
    return new THREE.ExtrudeGeometry(s, { depth: DEPTH, bevelEnabled: false });
}

function buildDiamondFixGeometry(angle=0, sb=false) {
    const outer = diamondOuterLocal(angle);
    const shaftR = 1.6, cskR = 5.0, cskDepth = 4.5;
    const shaftDepth = DEPTH - cskDepth;
    const CSK_LAYERS = 12;

    // Place hole on the diamond's symmetry axis at a safe distance
    const rad = angle * Math.PI / 180;
    const holeDist = HEX_S * 0.45;
    const fcx = -Math.sin(rad) * holeDist;
    const fcy = Math.cos(rad) * holeDist;

    function diamondWithHole(r) {
        const s = new THREE.Shape();
        s.moveTo(outer[0].x, outer[0].y);
        s.lineTo(outer[1].x, outer[1].y);
        s.lineTo(outer[2].x, outer[2].y);
        s.lineTo(outer[3].x, outer[3].y);
        s.lineTo(outer[4].x, outer[4].y);
        s.lineTo(outer[5].x, outer[5].y);
        s.closePath();
        const h = new THREE.Path();
        h.absarc(fcx, fcy, r, 0, Math.PI * 2, false);
        s.holes.push(h);
        return s;
    }

    function coneSlices(fromR, toR, zStart) {
        return Array.from({ length: CSK_LAYERS }, (_, i) => {
            const tt = i / CSK_LAYERS;
            const r = fromR + (toR - fromR) * tt;
            return extrude(diamondWithHole(r), cskDepth / CSK_LAYERS, zStart + tt * cskDepth);
        });
    }

    const geos = sb
        ? [extrude(diamondWithHole(shaftR), shaftDepth, 0), ...coneSlices(shaftR, cskR, shaftDepth)]
        : [...coneSlices(cskR, shaftR, 0), extrude(diamondWithHole(shaftR), shaftDepth, cskDepth)];
    return mergeGeos(geos);
}

// ─── Éclat (moitié du diamant, coupé sur l'axe Y) ────────────────────────────
// Le diamant a 6 pts : centre, p30°, coin60°, p90°, coin120°, p150°
// L'éclat = moitié droite : centre → p30° → coin60° → p90° (4 pts)
// 6 orientations par rotation de 60° en 60°

function eclatOuterLocal(angle=0) {
    // L'éclat de base occupe le secteur 30°→90° (moitié droite du diamant en bas)
    // angle = rotation appliquée (en degrés)
    const p30  = getHexBoundaryPt((30  + angle) * Math.PI / 180, HEX_S);
    const p90  = getHexBoundaryPt((90  + angle) * Math.PI / 180, HEX_S);
    const ext  = hexPts(HEX_S);
    const c1   = rotPoly([{ x: ext[1].x, y: ext[1].y }], angle * Math.PI / 180)[0]; // coin 60°
    return [
        { x: 0, y: 0 }, // centre
        p30,             // 30° sur bord
        c1,              // coin 60°
        p90              // 90° sur bord (axe de symétrie)
    ];
}

function eclatInnerLocal(angle=0) {
    const outer = eclatOuterLocal(angle);
    const scale = INNER_S / HEX_S;
    return outer.map(p => ({ x: p.x * scale, y: p.y * scale }));
}

function buildEclatGeometry(angle=0, sb=false) {
    const outer = eclatOuterLocal(angle);
    const geo = shoulderPair(innerS => {
        const wOff = WALL - (innerS - INNER_S);
        return (depth, z) => {
            const s = new THREE.Shape();
            s.moveTo(outer[0].x, outer[0].y);
            s.lineTo(outer[1].x, outer[1].y);
            s.lineTo(outer[2].x, outer[2].y);
            s.lineTo(outer[3].x, outer[3].y);
            s.closePath();
            const inset = insetPolyNoMinArea(outer, wOff);
            if (inset && inset.length > 0) {
                const h = new THREE.Path();
                h.moveTo(inset[0].x, inset[0].y);
                for (let i = 1; i < inset.length; i++) h.lineTo(inset[i].x, inset[i].y);
                h.closePath();
                s.holes.push(h);
            }
            return extrude(s, depth, z);
        };
    }, sb);
    return geo;
}

function buildEclatFullGeometry(angle=0) {
    const outer = eclatOuterLocal(angle);
    const s = new THREE.Shape();
    s.moveTo(outer[0].x, outer[0].y);
    s.lineTo(outer[1].x, outer[1].y);
    s.lineTo(outer[2].x, outer[2].y);
    s.lineTo(outer[3].x, outer[3].y);
    s.closePath();
    return new THREE.ExtrudeGeometry(s, { depth: DEPTH, bevelEnabled: false });
}

function buildEclatFixGeometry(angle=0, sb=false) {
    const outer = eclatOuterLocal(angle);
    const shaftR = 1.6, cskR = 3.5, cskDepth = 4.5;
    const shaftDepth = DEPTH - cskDepth;
    const CSK_LAYERS = 12;

    // Centroid of all 4 vertices (center + 3 outer points)
    const fcx = outer.reduce((s, p) => s + p.x, 0) / outer.length;
    const fcy = outer.reduce((s, p) => s + p.y, 0) / outer.length;

    function eclatWithHole(r) {
        const s = new THREE.Shape();
        s.moveTo(outer[0].x, outer[0].y);
        s.lineTo(outer[1].x, outer[1].y);
        s.lineTo(outer[2].x, outer[2].y);
        s.lineTo(outer[3].x, outer[3].y);
        s.closePath();
        const h = new THREE.Path();
        h.absarc(fcx, fcy, r, 0, Math.PI * 2, false);
        s.holes.push(h);
        return s;
    }

    function coneSlices(fromR, toR, zStart) {
        return Array.from({ length: CSK_LAYERS }, (_, i) => {
            const tt = i / CSK_LAYERS;
            const r = fromR + (toR - fromR) * tt;
            return extrude(eclatWithHole(r), cskDepth / CSK_LAYERS, zStart + tt * cskDepth);
        });
    }

    const geos = sb
        ? [extrude(eclatWithHole(shaftR), shaftDepth, 0), ...coneSlices(shaftR, cskR, shaftDepth)]
        : [...coneSlices(cskR, shaftR, 0), extrude(eclatWithHole(shaftR), shaftDepth, cskDepth)];
    return mergeGeos(geos);
}

function buildGeometry(type) {
    const sb = shoulderDir === 'back';
    if (type.startsWith('tri_'))       { const t=+type.slice(4);  return buildTriGeometry(t, sb); }
    if (type.startsWith('triFull_'))   { const t=+type.slice(8);  return buildTriFullGeometry(t); }
    if (type.startsWith('triFix_'))    { const t=+type.slice(7);  return buildTriFixGeometry(t, sb); }
    if (type.startsWith('diamond_'))    { const s=+type.slice(8);  return buildDiamondGeometry((s * 60 - 60 + 360) % 360, sb); }
    if (type.startsWith('diamondFull_')) { const s=+type.slice(12); return buildDiamondFullGeometry((s * 60 - 60 + 360) % 360); }
    if (type.startsWith('diamondFix_'))  { const s=+type.slice(11); return buildDiamondFixGeometry((s * 60 - 60 + 360) % 360, sb); }
    if (type==='diamond')              return buildDiamondGeometry(0, sb);
    if (type==='diamondFull')          return buildDiamondFullGeometry(0);
    if (type==='diamondFix')           return buildDiamondFixGeometry(0, sb);
    if (type.startsWith('eclat_'))     { const s=+type.slice(6);  return buildEclatGeometry((s * 60 - 60 + 360) % 360, sb); }
    if (type.startsWith('eclatFull_')) { const s=+type.slice(10); return buildEclatFullGeometry((s * 60 - 60 + 360) % 360); }
    if (type.startsWith('eclatFix_'))  { const s=+type.slice(9);  return buildEclatFixGeometry((s * 60 - 60 + 360) % 360, sb); }
    if (type==='eclat')                return buildEclatGeometry(0, sb);
    if (type==='eclatFull')            return buildEclatFullGeometry(0);
    if (type==='eclatFix')             return buildEclatFixGeometry(0, sb);
    if (type.startsWith('tiers_'))     { const t=+type.slice(6);  return buildTiersGeometry(t, sb); }
    if (type.startsWith('tiersFix_'))  { const t=+type.slice(9);  return buildTiersFixGeometry(t, sb); }
    if (type.startsWith('tiersFull_')) { const t=+type.slice(10); return buildTiersFullGeometry(t); }
    if (type.startsWith('trap_'))     { const s=+type.slice(5);  return buildTrapGeometry(sectorAngle(s), sb); }
    if (type.startsWith('trapFix_'))  { const s=+type.slice(8);  return buildTrapFixGeometry(sectorAngle(s), sb); }
    if (type.startsWith('trapFull_')) { const s=+type.slice(9);  return buildTrapFullGeometry(sectorAngle(s)); }
    if (type.startsWith('penta_'))    { const c=+type.slice(6);  return buildPentaGeometry(c, sb); }
    if (type.startsWith('pentaFix_')) { const c=+type.slice(9);  return buildPentaFixGeometry(c, sb); }
    if (type.startsWith('pentaFull_')){ const c=+type.slice(10); return buildPentaFullGeometry(c); }
    if (type.startsWith('quartFix_')) { const q=+type.slice(9);  return buildQuartFixGeometry(q, sb); }
    if (type.startsWith('quartFull_')){ const q=+type.slice(10); return buildQuartFullGeometry(q); }
    if (type.startsWith('quart_'))    { const q=+type.slice(6);  return buildQuartGeometry(q, sb); }
    if (type==='hexFull')             return buildHexFullGeometry();
    if (type==='hexFixFull')          return buildHexFixFullGeometry(sb);
    return buildHexByCrown(sb);
}

// ─── Bordure extérieure (finition) ───────────────────────────────────────────
let showBorder = false;
const borderMeshes = new Map();


const BORDER_MAT = new THREE.MeshStandardMaterial({
    color: 0xf39c12, roughness: .35, metalness: .1,
    emissive: 0xf39c12, emissiveIntensity: .06
});

// ─── Intérieur creux (trou) pour découpe de bordure ────────────────────────────
function hollowInteriorPoly(type) {
    const inn = hexPts(INNER_S).map(p => ({ x: p.x, y: p.y }));
    const ext = hexPts(HEX_S).map(p => ({ x: p.x, y: p.y }));
    let m;
    // Hexagone creux : le trou est l'hexagone intérieur
    if (type === 'add' || type === 'hex') {
        return { pts: inn };
    }
    // Trapèze creux
    m = type.match(/^trap_(\d+)$/);
    if (m) {
        const s = +m[1], ang = sectorAngle(s);
        const hy = ext[3].y + WALL;
        const innerPts = [
            { x: inn[0].x - WALL / 2, y: hy },
            { x: inn[3].x + WALL / 2, y: hy },
            { x: inn[2].x, y: inn[2].y },
            { x: inn[1].x, y: inn[1].y },
            { x: inn[0].x, y: inn[0].y }
        ];
        return { pts: rotPoly(innerPts, ang) };
    }
    // Pentagone creux
    m = type.match(/^penta_(\d+)$/);
    if (m) {
        const c = +m[1], ang = c * DEG60;
        const innerPts = [
            { x: WALL, y: inn[5].y },
            { x: inn[5].x, y: inn[5].y },
            { x: inn[0].x, y: inn[0].y },
            { x: inn[1].x, y: inn[1].y },
            { x: WALL, y: inn[1].y }
        ];
        return { pts: rotPoly(innerPts, ang) };
    }
    // Quart creux
    m = type.match(/^quart_(\d+)$/);
    if (m) {
        const q = +m[1], hy = WALL;
        let innerPts;
        if (q === 0) {
            innerPts = [
                { x: inn[0].x - WALL / 2, y: hy },
                { x: WALL, y: hy },
                { x: WALL, y: inn[1].y },
                { x: inn[1].x, y: inn[1].y },
                { x: inn[0].x, y: inn[0].y }
            ];
        } else if (q === 1) {
            innerPts = [
                { x: -inn[0].x, y: inn[0].y },
                { x: -inn[1].x, y: inn[1].y },
                { x: -WALL, y: inn[1].y },
                { x: -WALL, y: hy },
                { x: -(inn[0].x - WALL / 2), y: hy }
            ];
        } else if (q === 2) {
            innerPts = [
                { x: -(inn[0].x - WALL / 2), y: -hy },
                { x: -WALL, y: -hy },
                { x: -WALL, y: -inn[1].y },
                { x: -inn[1].x, y: -inn[1].y },
                { x: -inn[0].x, y: -inn[0].y }
            ];
        } else {
            innerPts = [
                { x: inn[0].x - WALL / 2, y: -hy },
                { x: WALL, y: -hy },
                { x: WALL, y: -inn[1].y },
                { x: inn[1].x, y: -inn[1].y },
                { x: inn[0].x, y: -inn[0].y }
            ];
        }
        return { pts: innerPts };
    }
    // Triangle creux
    m = type.match(/^tri_(\d+)$/);
    if (m) {
        const ti = +m[1];
        const wOff = WALL;
        const A = { x: 0, y: 0 };
        const B = { x: ext[ti].x, y: ext[ti].y };
        const C = { x: ext[(ti+1)%6].x, y: ext[(ti+1)%6].y };
        const inset = insetTriangle(A, B, C, wOff);
        if (inset) return { pts: inset };
    }
    // Tiers creux
    m = type.match(/^tiers_(\d+)$/);
    if (m) {
        const ti = +m[1];
        const wOff = WALL;
        const A = { x: 0, y: 0 };
        const B = { x: ext[ti].x, y: ext[ti].y };
        const C = { x: ext[(ti+1)%6].x, y: ext[(ti+1)%6].y };
        const D = { x: ext[(ti+2)%6].x, y: ext[(ti+2)%6].y };
        const inset = insetQuad(A, B, C, D, wOff);
        if (inset) return { pts: inset };
    }
    // Diamant creux (avec secteur)
    m = type.match(/^diamond_(\d+)$/);
    if (m) {
        const s = +m[1], ang = (s * 60 - 60 + 360) % 360;
        const outer = diamondOuterLocal(ang);
        const inset = insetPoly(outer, WALL);
        if (inset) return { pts: inset };
    }
    // Diamant creux (sans secteur, legacy)
    if (type === 'diamond') {
        const outer = diamondOuterLocal();
        const inset = insetPoly(outer, WALL);
        if (inset) return { pts: inset };
    }
    // Éclat creux (avec secteur)
    m = type.match(/^eclat_(\d+)$/);
    if (m) {
        const s = +m[1], ang = (s * 60 - 60 + 360) % 360;
        const outer = eclatOuterLocal(ang);
        const inset = insetPolyNoMinArea(outer, WALL);
        if (inset) return { pts: inset };
    }
    // Les types "Full" et "Fix" n'ont pas de trou creux
    return null;
}

function outerBorderPoly(type) {
    const ext = hexPts(HEX_S).map(p => ({ x: p.x, y: p.y }));
    if (type === 'add' || type === 'hex' || type === 'hexFull' || type === 'hexFixFull')
        return { pts: ext };
    let m;
    m = type.match(/^trap(?:Fix|Full)?_(\d+)$/);
    if (m) {
        const pts = rotPoly([ext[0], ext[1], ext[2], ext[3]], sectorAngle(+m[1]));
        return { pts };
    }
    m = type.match(/^penta(?:Fix|Full)?_(\d+)$/);
    if (m) {
        const pts = rotPoly([
            { x: 0, y: ext[5].y }, { x: ext[5].x, y: ext[5].y },
            { x: ext[0].x, y: ext[0].y },
            { x: ext[1].x, y: ext[1].y }, { x: 0, y: ext[1].y }
        ], +m[1] * DEG60);
        return { pts };
    }
    m = type.match(/^tri(?:Full|Fix)?_(\d+)$/);
    if (m) {
        const ti = +m[1];
        return { pts: triOuterLocal(ti) };
    }
    m = type.match(/^tiers(?:Fix|Full)?_(\d+)$/);
    if (m) {
        const ti = +m[1];
        return { pts: tiersOuterLocal(ti) };
    }
    m = type.match(/^quart(?:Fix|Full)?_(\d+)$/);
    if (m) {
        const pts = quartOuterLocal(+m[1]);
        return { pts };
    }
    m = type.match(/^diamond(?:Full|Fix)?_(\d+)$/);
    if (m) {
        const s = +m[1], ang = (s * 60 - 60 + 360) % 360;
        return { pts: diamondOuterLocal(ang) };
    }
    m = type.match(/^eclat(?:Full|Fix)?_(\d+)$/);
    if (m) {
        const s = +m[1], ang = (s * 60 - 60 + 360) % 360;
        return { pts: eclatOuterLocal(ang) };
    }
    return null;
}

const EDGE_EPS = 0.15;

// Project point P onto line AB, return scalar t in [0,1] if on segment, or null
function projectOnSegment(px, py, ax, ay, bx, by) {
    const dx = bx - ax, dy = by - ay;
    const len2 = dx * dx + dy * dy;
    if (len2 < 1e-12) return null;
    const t = ((px - ax) * dx + (py - ay) * dy) / len2;
    return t;
}

// Check if two segments are collinear (same infinite line, same direction or opposite)
function segmentsCollinear(ax, ay, bx, by, px, py, qx, qy) {
    const dx = bx - ax, dy = by - ay;
    const len = Math.hypot(dx, dy);
    if (len < 1e-9) return false;
    const nx = dy / len, ny = -dx / len; // normal to AB
    // Check if P and Q are on the same infinite line as AB
    const dP = Math.abs((px - ax) * nx + (py - ay) * ny);
    const dQ = Math.abs((qx - ax) * nx + (qy - ay) * ny);
    return dP < EDGE_EPS && dQ < EDGE_EPS;
}

// Given collinear segments AB and PQ (in AB's param space), compute overlap interval
// Returns [tStart, tEnd] in AB's space, or null if no overlap
function collinearOverlap(ax, ay, bx, by, px, py, qx, qy) {
    const dx = bx - ax, dy = by - ay;
    const len2 = dx * dx + dy * dy;
    if (len2 < 1e-12) return null;
    const tP = ((px - ax) * dx + (py - ay) * dy) / len2;
    const tQ = ((qx - ax) * dx + (qy - ay) * dy) / len2;
    const tMin = Math.min(tP, tQ);
    const tMax = Math.max(tP, tQ);
    // Overlap with [0,1]
    const oMin = Math.max(0, tMin);
    const oMax = Math.min(1, tMax);
    if (oMax - oMin < 1e-6) return null;
    return [oMin, oMax];
}

// Returns true if point (px,py) is strictly inside convex polygon pts (world coords)
function pointInsideConvexPoly(px, py, pts) {
    const n = pts.length;
    for (let i = 0; i < n; i++) {
        const a = pts[i], b = pts[(i + 1) % n];
        if (cross2(b.x - a.x, b.y - a.y, px - a.x, py - a.y) < -1e-6) return false;
    }
    return true;
}

// Returns the free sub-segments of edge AB (as t params in [0,1]) after subtracting all neighbor overlaps
// Returns array of [tA, tB] free intervals
function freeSubSegments(ax, ay, bx, by, selfSk) {
    let free = [[0, 1]];

    for (const [sk, mesh] of elements) {
        if (sk === selfSk) continue;
        const type = elementTypes.get(sk);
        const res = outerBorderPoly(type);
        if (!res) continue;
        const { pts } = res;
        const { x: ncx, y: ncy } = mesh.position;
        if (Math.hypot(ncx - (ax + bx) / 2, ncy - (ay + by) / 2) > 3 * HEX_S) continue;
        const n = pts.length;
        for (let i = 0; i < n; i++) {
            const p = pts[i], q2 = pts[(i + 1) % n];
            const px = p.x + ncx, py = p.y + ncy;
            const qx = q2.x + ncx, qy = q2.y + ncy;
            if (!segmentsCollinear(ax, ay, bx, by, px, py, qx, qy)) continue;
            const ov = collinearOverlap(ax, ay, bx, by, px, py, qx, qy);
            if (!ov) continue;
            // Subtract [ov[0], ov[1]] from free intervals
            const newFree = [];
            for (const [fa, fb] of free) {
                if (ov[1] <= fa + 1e-6 || ov[0] >= fb - 1e-6) {
                    newFree.push([fa, fb]); // no overlap
                } else {
                    if (ov[0] > fa + 1e-6) newFree.push([fa, ov[0]]);
                    if (ov[1] < fb - 1e-6) newFree.push([ov[1], fb]);
                }
            }
            free = newFree;
            if (!free.length) return [];
        }
    }
    return free;
}

function edgeCoveredByNeighbor(ax, ay, bx, by, selfSk) {
    return freeSubSegments(ax, ay, bx, by, selfSk).length === 0;
}

function edgeNormal(ax, ay, bx, by) {
    const ex = bx - ax, ey = by - ay;
    const len = Math.hypot(ex, ey) || 1;
    return { nx: ey / len, ny: -ex / len };
}

function neighborEdgeEndingAt(wx, wy, selfSk) {
    for (const [sk, mesh] of elements) {
        if (sk === selfSk) continue;
        const type = elementTypes.get(sk);
        const res = outerBorderPoly(type);
        if (!res) continue;
        const { pts } = res;
        const { x: ncx, y: ncy } = mesh.position;
        const np = pts.length;
        for (let i = 0; i < np; i++) {
            const pa = pts[i], pb = pts[(i + 1) % np];
            const wbx = pb.x + ncx, wby = pb.y + ncy;
            if (Math.hypot(wbx - wx, wby - wy) < EDGE_EPS) {
                return {
                    nx: edgeNormal(pa.x + ncx, pa.y + ncy, wbx, wby).nx,
                    ny: edgeNormal(pa.x + ncx, pa.y + ncy, wbx, wby).ny,
                    dx: wbx - (pa.x + ncx), dy: wby - (pa.y + ncy)
                };
            }
        }
    }
    return null;
}

function neighborEdgeStartingAt(wx, wy, selfSk) {
    for (const [sk, mesh] of elements) {
        if (sk === selfSk) continue;
        const type = elementTypes.get(sk);
        const res = outerBorderPoly(type);
        if (!res) continue;
        const { pts } = res;
        const { x: ncx, y: ncy } = mesh.position;
        const np = pts.length;
        for (let i = 0; i < np; i++) {
            const pa = pts[i], pb = pts[(i + 1) % np];
            const wax = pa.x + ncx, way = pa.y + ncy;
            if (Math.hypot(wax - wx, way - wy) < EDGE_EPS) {
                return {
                    nx: edgeNormal(wax, way, pb.x + ncx, pb.y + ncy).nx,
                    ny: edgeNormal(wax, way, pb.x + ncx, pb.y + ncy).ny,
                    dx: (pb.x + ncx) - wax, dy: (pb.y + ncy) - way
                };
            }
        }
    }
    return null;
}

function computeMiter(P, n1, d1, n2, d2, cx, cy) {
    const cross = n1.nx * n2.ny - n1.ny * n2.nx;
    if (cross <= 1e-6) return null;
    const ox1 = P.x + n1.nx * WALL, oy1 = P.y + n1.ny * WALL;
    const ox2 = P.x + n2.nx * WALL, oy2 = P.y + n2.ny * WALL;
    const denom = d1.dx * d2.dy - d1.dy * d2.dx;
    if (Math.abs(denom) < 1e-9) return null;
    const t = ((ox2 - ox1) * d2.dy - (oy2 - oy1) * d2.dx) / denom;
    const mx = ox1 + t * d1.dx - cx;
    const my = oy1 + t * d1.dy - cy;
    const dotCheck = (mx - (P.x - cx)) * n2.nx + (my - (P.y - cy)) * n2.ny;
    if (dotCheck < -1e-6) return null;
    return { x: mx, y: my };
}

function buildBorderGeometry(sk, type, q, r) {
    const res = outerBorderPoly(type);
    if (!res) return null;
    const { pts: poly } = res;
    const { x: cx, y: cy } = cellPos(q, r);
    const n = poly.length;

    const worldPts = poly.map(p => ({ x: p.x + cx, y: p.y + cy }));

    // For each edge, compute free sub-segment intervals [tA,tB] in [0,1]
    const edgeFreeSegs = worldPts.map((p, i) => {
        const p2 = worldPts[(i + 1) % n];
        return freeSubSegments(p.x, p.y, p2.x, p2.y, sk);
    });

    const hasAnyFree = edgeFreeSegs.some(segs => segs.length > 0);
    if (!hasAnyFree) return null;

    // ─── Masques fantômes : empreintes 2D des pièces voisines ────────────────
    // Séparation : colocataires (même cellule) → suppression agressive
    //              voisins externes → découpe avec trous
    // IMPORTANT : on utilise l'intérieur creux (hollowInteriorPoly) pour la découpe,
    // car c'est là que la bordure ne doit PAS pénétrer (le trou de la pièce voisine).
    const clipMasksExternal = [];
    const clipMasksCellMate = [];
    for (const [nsk, nmesh] of elements) {
        if (nsk === sk) continue;
        const ntype = elementTypes.get(nsk);
        const { x: ncx, y: ncy } = nmesh.position;
        if (Math.hypot(ncx - cx, ncy - cy) > 3.5 * HEX_S) continue;
        const isCellMate = nmesh.userData.q === q && nmesh.userData.r === r;
        const nres = outerBorderPoly(ntype);
        if (!nres) continue;
        let worldMask = nres.pts.map(p => ({ x: p.x + ncx, y: p.y + ncy }));
        if (polygonSignedArea(worldMask) < 0) worldMask = worldMask.reverse();
        if (isCellMate) clipMasksCellMate.push({ nsk, worldMask });
        else clipMasksExternal.push({ nsk, worldMask });
    }
    // Ajouter les masques creux des voisins externes pour le clipping
    // On utilise l'outerBorder (pas hollowInteriorPoly) car la bordure ne doit
    // pénétrer DANS AUCUNE partie de la pièce voisine (ni creux ni solide).
    for (const [nsk, nmesh] of elements) {
        if (nsk === sk) continue;
        if (nmesh.userData.q === q && nmesh.userData.r === r) continue;
        const ntype = elementTypes.get(nsk);
        const { x: ncx, y: ncy } = nmesh.position;
        if (Math.hypot(ncx - cx, ncy - cy) > 3.5 * HEX_S) continue;
        const nres = outerBorderPoly(ntype);
        if (!nres) continue;
        let worldMask = nres.pts.map(p => ({ x: p.x + ncx, y: p.y + ncy }));
        if (polygonSignedArea(worldMask) < 0) worldMask = worldMask.reverse();
        clipMasksExternal.push({ nsk, worldMask });
    }
    // Ajouter aussi les masques outerBorder des voisins externes (pour détecter
    // la bordure qui pénètre dans la partie solide du voisin)
    for (const [nsk, nmesh] of elements) {
        if (nsk === sk) continue;
        if (nmesh.userData.q === q && nmesh.userData.r === r) continue;
        const ntype = elementTypes.get(nsk);
        const { x: ncx, y: ncy } = nmesh.position;
        if (Math.hypot(ncx - cx, ncy - cy) > 3.5 * HEX_S) continue;
        const nres = outerBorderPoly(ntype);
        if (!nres) continue;
        let worldMask = nres.pts.map(p => ({ x: p.x + ncx, y: p.y + ncy }));
        if (polygonSignedArea(worldMask) < 0) worldMask = worldMask.reverse();
        clipMasksExternal.push({ nsk, worldMask, isOuter: true });
    }
    // Réunion pour le debug (compatibilité)
    const clipMasks = [...clipMasksCellMate, ...clipMasksExternal];

    // ─── Colocataires dans la même cellule ──────────────────────────────────
    // Pièces dans la même cellule (q,r) : leurs bords radiaux passant par
    // l'origine sont internes et ne doivent pas générer de mur de bordure.
    const cellMateMasks = [];
    for (const [nsk, nmesh] of elements) {
        if (nsk === sk) continue;
        if (nmesh.userData.q !== q || nmesh.userData.r !== r) continue;
        const ntype = elementTypes.get(nsk);
        const nres = outerBorderPoly(ntype);
        if (!nres) continue;
        let worldMask = nres.pts.map(p => ({ x: p.x + cx, y: p.y + cy }));
        if (polygonSignedArea(worldMask) < 0) worldMask = worldMask.reverse();
        cellMateMasks.push(worldMask);
    }

    // Returns true if point (px,py) is inside or on convex polygon (tolerance tol)
    function ptInsidePoly(px, py, poly, tol = 1e-4) {
        for (let i = 0; i < poly.length; i++) {
            const a = poly[i], b = poly[(i + 1) % poly.length];
            if (cross2(b.x - a.x, b.y - a.y, px - a.x, py - a.y) < -tol) return false;
        }
        return true;
    }

    // An edge is internal if its outward wall normal points INTO a cell-mate polygon.
    // We test: midpoint + small step along normal is inside the cell-mate.
    function isInternalEdge(Aw, Bw) {
        const midX = (Aw.x + Bw.x) / 2, midY = (Aw.y + Bw.y) / 2;
        const { nx: enx, ny: eny } = edgeNormal(Aw.x, Aw.y, Bw.x, Bw.y);
        const testX = midX + enx * (WALL * 0.5);
        const testY = midY + eny * (WALL * 0.5);
        for (const mask of cellMateMasks) {
            if (ptInsidePoly(testX, testY, mask, 1e-4)) return true;
        }
        return false;
    }

    const geos = [];

    for (let i = 0; i < n; i++) {
        const segs = edgeFreeSegs[i];
        const A = worldPts[i];
        const B = worldPts[(i + 1) % n];

        if (!segs.length) continue;

        const edgeDx = B.x - A.x, edgeDy = B.y - A.y;
        const { nx, ny } = edgeNormal(A.x, A.y, B.x, B.y);
        const n_cur = { nx, ny };
        const d_cur = { dx: edgeDx, dy: edgeDy };

        // Whole edge free flags (for miter computation context)
        const edgeFullyFreeAtStart = edgeFreeSegs[i][0][0] < 1e-6;
        const edgeFullyFreeAtEnd   = edgeFreeSegs[i][edgeFreeSegs[i].length - 1][1] > 1 - 1e-6;

        for (const [tA, tB] of segs) {
            // World coords of sub-segment
            const Asub = { x: A.x + tA * edgeDx, y: A.y + tA * edgeDy };
            const Bsub = { x: A.x + tB * edgeDx, y: A.y + tB * edgeDy };

            // Check if this sub-segment is internal (its midpoint+normal points into a cellmate).
            // We test the sub-segment midpoint, not the full edge midpoint, so partial
            // sub-segments that are outside the cellmate are correctly included.
            if (cellMateMasks.length > 0 && isInternalEdge(Asub, Bsub)) continue;

            const ax = Asub.x - cx, ay = Asub.y - cy;
            const bx = Bsub.x - cx, by = Bsub.y - cy;
            let lox = ax + nx * WALL, loy = ay + ny * WALL;
            let rox = bx + nx * WALL, roy = by + ny * WALL;

            // Returns true if point (wx,wy) lies on the boundary of a convex polygon
            // (within tolerance), i.e. its distance to any edge is < tol.
            function ptOnPolyBoundary(wx, wy, poly, tol) {
                for (let pi = 0; pi < poly.length; pi++) {
                    const a = poly[pi], b = poly[(pi + 1) % poly.length];
                    const dx = b.x - a.x, dy = b.y - a.y;
                    const len2 = dx * dx + dy * dy;
                    if (len2 < 1e-12) continue;
                    const t = Math.max(0, Math.min(1, ((wx - a.x) * dx + (wy - a.y) * dy) / len2));
                    const px = a.x + t * dx, py = a.y + t * dy;
                    if (Math.hypot(wx - px, wy - py) < tol) return true;
                }
                return false;
            }

            // A miter corner is valid only if the computed miter point doesn't fall
            // inside any external neighbor mask. Use WALL/2 tolerance to also catch
            // miters that graze the boundary (tip-to-tip shared vertex cases).
            function miterOk(mx, my) {
                const mwx = mx + cx, mwy = my + cy;
                for (const { worldMask } of clipMasksExternal) {
                    if (ptInsidePoly(mwx, mwy, worldMask, WALL * 0.5)) return false;
                }
                return true;
            }

            // Miter at start of sub-segment
            const isAtEdgeStart = tA < 1e-6;
            if (isAtEdgeStart) {
                const iPrev = (i - 1 + n) % n;
                const prevSegs = edgeFreeSegs[iPrev];
                const prevEdgeFreeTail = prevSegs.length > 0 && prevSegs[prevSegs.length - 1][1] > 1 - 1e-6;
                if (prevEdgeFreeTail) {
                    const Ap = worldPts[iPrev];
                    const n_prev = edgeNormal(Ap.x, Ap.y, A.x, A.y);
                    const d_prev = { dx: A.x - Ap.x, dy: A.y - Ap.y };
                    const m = computeMiter(A, n_prev, d_prev, n_cur, d_cur, cx, cy);
                    if (m && !cellMateMasks.some(mask => ptInsidePoly(m.x + cx, m.y + cy, mask, 1e-4))
                           && miterOk(m.x, m.y)) { lox = m.x; loy = m.y; }
                } else {
                    const nb = neighborEdgeEndingAt(A.x, A.y, sk);
                    if (nb) {
                        const m = computeMiter(A, nb, nb, n_cur, d_cur, cx, cy);
                        if (m && !cellMateMasks.some(mask => ptInsidePoly(m.x + cx, m.y + cy, mask, 1e-4))
                               && miterOk(m.x, m.y)) { lox = m.x; loy = m.y; }
                    }
                }
            }

            // Miter at end of sub-segment
            const isAtEdgeEnd = tB > 1 - 1e-6;
            if (isAtEdgeEnd) {
                const iNext = (i + 1) % n;
                const nextSegs = edgeFreeSegs[iNext];
                const nextEdgeFreeHead = nextSegs.length > 0 && nextSegs[0][0] < 1e-6;
                if (nextEdgeFreeHead) {
                    const C = worldPts[(i + 2) % n];
                    const n_next = edgeNormal(B.x, B.y, C.x, C.y);
                    const d_next = { dx: C.x - B.x, dy: C.y - B.y };
                    const m = computeMiter(B, n_cur, d_cur, n_next, d_next, cx, cy);
                    if (m && !cellMateMasks.some(mask => ptInsidePoly(m.x + cx, m.y + cy, mask, 1e-4))
                           && miterOk(m.x, m.y)) { rox = m.x; roy = m.y; }
                } else {
                    const nb = neighborEdgeStartingAt(B.x, B.y, sk);
                    if (nb) {
                        const m = computeMiter(B, n_cur, d_cur, nb, nb, cx, cy);
                        if (m && !cellMateMasks.some(mask => ptInsidePoly(m.x + cx, m.y + cy, mask, 1e-4))
                               && miterOk(m.x, m.y)) { rox = m.x; roy = m.y; }
                    }
                }
            }

            // ── Projection de lox/rox hors des masques voisins ──────────────────
            // Cellmates seulement — les coins aux vertex sont gérés par miterOk()
            // et le clipping des quads contre les masques creux.
            function projectCornerOntoMask(wx, wy, mask) {
                let bestX = wx, bestY = wy, bestD = Infinity;
                for (let pi = 0; pi < mask.length; pi++) {
                    const a = mask[pi], b = mask[(pi+1)%mask.length];
                    const dx = b.x-a.x, dy = b.y-a.y, l2 = dx*dx+dy*dy;
                    if (l2 < 1e-12) continue;
                    const t = Math.max(0, Math.min(1, ((wx-a.x)*dx+(wy-a.y)*dy)/l2));
                    const px = a.x+t*dx, py = a.y+t*dy;
                    const d = Math.hypot(wx-px, wy-py);
                    if (d < bestD) { bestD=d; bestX=px; bestY=py; }
                }
                return { x: bestX, y: bestY };
            }
            {
                let loxW = lox + cx, loyW = loy + cy;
                let roxW = rox + cx, royW = roy + cy;
                for (const mask of cellMateMasks) {
                    if (ptInsidePoly(loxW, loyW, mask, 1e-4)) {
                        const p = projectCornerOntoMask(loxW, loyW, mask);
                        console.log(`[PROJECT] sk=${sk} left corner projected from (${loxW.toFixed(2)},${loyW.toFixed(2)}) to (${p.x.toFixed(2)},${p.y.toFixed(2)})`);
                        loxW = p.x; loyW = p.y;
                    }
                    if (ptInsidePoly(roxW, royW, mask, 1e-4)) {
                        const p = projectCornerOntoMask(roxW, royW, mask);
                        console.log(`[PROJECT] sk=${sk} right corner projected from (${roxW.toFixed(2)},${royW.toFixed(2)}) to (${p.x.toFixed(2)},${p.y.toFixed(2)})`);
                        roxW = p.x; royW = p.y;
                    }
                }
                lox = loxW - cx; loy = loyW - cy;
                rox = roxW - cx; roy = royW - cy;
            }
            // Projection supplémentaire contre les masques creux externes
            {
                let loxW = lox + cx, loyW = loy + cy;
                let roxW = rox + cx, royW = roy + cy;
                for (const { worldMask, isHollow } of clipMasksExternal) {
                    if (!isHollow) continue;
                    if (ptInsidePoly(loxW, loyW, worldMask, 1e-4)) {
                        const p = projectCornerOntoMask(loxW, loyW, worldMask);
                        console.log(`[PROJECT-EXT] sk=${sk} left corner projected from (${loxW.toFixed(2)},${loyW.toFixed(2)}) to (${p.x.toFixed(2)},${p.y.toFixed(2)})`);
                        loxW = p.x; loyW = p.y;
                    }
                    if (ptInsidePoly(roxW, royW, worldMask, 1e-4)) {
                        const p = projectCornerOntoMask(roxW, royW, worldMask);
                        console.log(`[PROJECT-EXT] sk=${sk} right corner projected from (${roxW.toFixed(2)},${royW.toFixed(2)}) to (${p.x.toFixed(2)},${p.y.toFixed(2)})`);
                        roxW = p.x; royW = p.y;
                    }
                }
                lox = loxW - cx; loy = loyW - cy;
                rox = roxW - cx; roy = royW - cy;
            }

            const quadWorld = [
                { x: ax + cx, y: ay + cy },
                { x: bx + cx, y: by + cy },
                { x: rox + cx, y: roy + cy },
                { x: lox + cx, y: loy + cy },
            ];
            const quadArea = polygonArea(quadWorld);
            let clippedQuad = [...quadWorld];
            let skipQuad = false;
            if (quadArea < 0.05) {
                skipQuad = true;
            }

            if (!skipQuad) {
            // ── Voisins externes : supprimer les quads qui intersectent ─────
            for (const { nsk, worldMask } of clipMasksExternal) {
                const inter = intersectConvexPoly(clippedQuad, worldMask);
                if (!inter || inter.length < 3) continue;
                const interArea = polygonArea(inter);
                const qArea = polygonArea(clippedQuad);
                // Ignorer les micro-chevauchements (< 5% de la surface du quad)
                if (interArea < 0.05 * qArea) continue;

                skipQuad = true;
                break;
            }
            if (!skipQuad && polygonArea(clippedQuad) < 0.05) skipQuad = true;
            } // end if (!skipQuad)

            if (skipQuad) continue;

            // Construction du THREE.Shape à partir du quad clippé (sans trous)
            const shapePts = clippedQuad.map(p => new THREE.Vector2(p.x - cx, p.y - cy));
            const shape = new THREE.Shape(shapePts);

            geos.push(new THREE.ExtrudeGeometry(shape, { depth: DEPTH, bevelEnabled: false }));
        }
    }



    if (!geos.length) return null;
    return geos.length === 1 ? geos[0] : mergeGeos(geos);
}

function addBorderMesh(sk, type, q, r) {
    removeBorderMesh(sk);
    const geo = buildBorderGeometry(sk, type, q, r);
    if (!geo) return;
    const mat = BORDER_MAT.clone();
    const layerId = pieceToLayer.get(sk);
    if (layerId) {
        const layer = layers.get(layerId);
        if (layer) {
            mat.color.set(layer.color);
            mat.emissive.set(layer.color);
        }
    }
    const mesh = new THREE.Mesh(geo, mat);
    const { x, y } = cellPos(q, r);
    mesh.position.set(x, y, 0);
    scene.add(mesh);
    borderMeshes.set(sk, mesh);
}

function removeBorderMesh(sk) {
    const m = borderMeshes.get(sk);
    if (m) { scene.remove(m); m.geometry.dispose(); m.material.dispose(); borderMeshes.delete(sk); }
}

function refreshNeighborBorders(q, r) {
    if (!showBorder) return;
    const { x: cx, y: cy } = cellPos(q, r);
    elements.forEach((mesh, sk) => {
        const t = elementTypes.get(sk);
        const { q: nq, r: nr } = mesh.userData;
        if (Math.hypot(mesh.position.x - cx, mesh.position.y - cy) > 2.5 * HEX_S) return;
        addBorderMesh(sk, t, nq, nr);
    });
}

// ─── State ───────────────────────────────────────────────────────────────────
let scene, camera, orthoCamera, renderer, controls;
let activeTool  = 'add';
let shoulderDir = 'back';
let isOrtho     = false;
let gridVisible = true;
let isPainting  = false, isErasing = false;
let lastPaintKey = null, lastEraseKey = null, currentMouseE = null;
let didDrag = false;
let isDraggingGroup = false;
let groupDragStartQ = 0, groupDragStartR = 0;
let groupDragStartHitX = 0, groupDragStartHitY = 0;
let groupDragOriginalPositions = new Map(); // sk -> {q, r}
const mouseStart   = new THREE.Vector2();
const raycaster    = new THREE.Raycaster();
const ndcMouse     = new THREE.Vector2();
const elements     = new Map();
const elementTypes = new Map();
const hitPlanes    = new Map();
const gridLines    = [];
let lockedOrientation = new Map();
let isShiftHeld = false;
let hasInteracted = false;
let isDemoLoaded = false;

// ─── Layer System ────────────────────────────────────────────────────────────
const LAYER_COLORS = [0xf39c12, 0x3498db, 0xe74c3c, 0x2ecc71, 0x9b59b6, 0x1abc9c, 0xe67e22, 0x2980b9, 0xf1c40f, 0x1abc9c];
let layers = new Map();
let pieceToLayer = new Map();
let activeLayerId = 'default';
let selectedPieces = new Set();
const selectionHighlights = new Map();
let nextLayerId = 1;
let pendingColorLayerId = null;
let dragLayerId = null;
let contextMenuEl = null;

// ─── Slot helpers ─────────────────────────────────────────────────────────────
function slotKey(q, r, slot) { return `${q},${r}|${slot}`; }
function indexedSlots(prefix, n=6) { return Array.from({length:n}, (_,i) => `${prefix}_${i}`); }

const FULL_CELL = ['hex','hexFull','hexFixFull'];
const ALL_TRAP_SLOTS = [...indexedSlots('trap'), ...indexedSlots('trapFix'), ...indexedSlots('trapFull')];
const ALL_PENTA_SLOTS = [...indexedSlots('penta'), ...indexedSlots('pentaFix'), ...indexedSlots('pentaFull')];
const ALL_QUART_SLOTS = [...indexedSlots('quart', 4), ...indexedSlots('quartFix', 4), ...indexedSlots('quartFull', 4)];
const ALL_TRI_SLOTS   = [...indexedSlots('tri'),   ...indexedSlots('triFull'), ...indexedSlots('triFix')];
const ALL_DIAMOND_SLOTS = [...indexedSlots('diamond'), ...indexedSlots('diamondFull'), ...indexedSlots('diamondFix')];
const ALL_ECLAT_SLOTS = [...indexedSlots('eclat'), ...indexedSlots('eclatFull'), ...indexedSlots('eclatFix')];
const ALL_TIERS_SLOTS = [...indexedSlots('tiers'), ...indexedSlots('tiersFix'), ...indexedSlots('tiersFull')];
const ALL_SLOTS = [...FULL_CELL, ...ALL_TRAP_SLOTS, ...ALL_PENTA_SLOTS, ...ALL_QUART_SLOTS, ...ALL_TRI_SLOTS, ...ALL_DIAMOND_SLOTS, ...ALL_ECLAT_SLOTS, ...ALL_TIERS_SLOTS];

// ─── Encombrement 2D (matériau) ──────────────────────────────────────────────
const OVERLAP_EPS = 0.12;

function polygonArea(pts) {
    if (!pts || pts.length < 3) return 0;
    let a = 0;
    for (let i = 0; i < pts.length; i++) { const j = (i + 1) % pts.length; a += pts[i].x * pts[j].y - pts[j].x * pts[i].y; }
    return Math.abs(a * 0.5);
}

function polygonSignedArea(pts) {
    if (!pts || pts.length < 3) return 0;
    let a = 0;
    for (let i = 0; i < pts.length; i++) { const j = (i + 1) % pts.length; a += pts[i].x * pts[j].y - pts[j].x * pts[i].y; }
    return a * 0.5;
}

function cross2(ax, ay, bx, by) { return ax * by - ay * bx; }
function isInsideHalfPlane(p, a, b) { return cross2(b.x - a.x, b.y - a.y, p.x - a.x, p.y - a.y) >= -1e-10; }

function intersectLinesInf(p1, p2, p3, p4) {
    const x1 = p1.x, y1 = p1.y, x2 = p2.x, y2 = p2.y, x3 = p3.x, y3 = p3.y, x4 = p4.x, y4 = p4.y;
    const d = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4);
    if (Math.abs(d) < 1e-14) return null;
    const t = ((x1 - x3) * (y3 - y4) - (y1 - y3) * (x3 - x4)) / d;
    return { x: x1 + t * (x2 - x1), y: y1 + t * (y2 - y1) };
}

function clipAgainstEdge(poly, a, b) {
    if (!poly.length) return [];
    const out = [];
    for (let i = 0; i < poly.length; i++) {
        const cur = poly[i], prev = poly[(i + poly.length - 1) % poly.length];
        const curIn = isInsideHalfPlane(cur, a, b), prevIn = isInsideHalfPlane(prev, a, b);
        if (curIn) { if (!prevIn) { const ix = intersectLinesInf(prev, cur, a, b); if (ix) out.push(ix); } out.push(cur); }
        else if (prevIn) { const ix = intersectLinesInf(prev, cur, a, b); if (ix) out.push(ix); }
    }
    return out;
}

// Clip polygon keeping points OUTSIDE (to the right of) edge a→b
function clipOutsideEdge(poly, a, b) {
    if (!poly.length) return [];
    const out = [];
    for (let i = 0; i < poly.length; i++) {
        const cur = poly[i], prev = poly[(i + poly.length - 1) % poly.length];
        const curOut = !isInsideHalfPlane(cur, a, b), prevOut = !isInsideHalfPlane(prev, a, b);
        if (curOut) { if (!prevOut) { const ix = intersectLinesInf(prev, cur, a, b); if (ix) out.push(ix); } out.push(cur); }
        else if (prevOut) { const ix = intersectLinesInf(prev, cur, a, b); if (ix) out.push(ix); }
    }
    return out;
}

// Find intersection of ray from inner→outer with mask boundary.
// Returns the point on the mask edge closest to inner (first hit along the ray).
function rayMaskSegments(innerX, innerY, outerX, outerY, worldMask) {
    const results = [];
    for (let ei = 0; ei < worldMask.length; ei++) {
        const ma = worldMask[ei], mb = worldMask[(ei + 1) % worldMask.length];
        const hit = segmentsIntersect(innerX, innerY, outerX, outerY, ma.x, ma.y, mb.x, mb.y);
        if (hit) results.push(hit);
    }
    return results;
}

function rayMaskIntersection(innerX, innerY, outerX, outerY, worldMask) {
    const hits = rayMaskSegments(innerX, innerY, outerX, outerY, worldMask);
    if (!hits.length) return null;
    // Return the hit closest to the inner point
    let best = hits[0], bestD = Math.hypot(hits[0].x - innerX, hits[0].y - innerY);
    for (let i = 1; i < hits.length; i++) {
        const d = Math.hypot(hits[i].x - innerX, hits[i].y - innerY);
        if (d < bestD) { best = hits[i]; bestD = d; }
    }
    return best;
}

function segmentsIntersect(x1,y1,x2,y2,x3,y3,x4,y4) {
    const d = (x1-x2)*(y3-y4)-(y1-y2)*(x3-x4);
    if (Math.abs(d) < 1e-12) return null;
    const t = ((x1-x3)*(y3-y4)-(y1-y3)*(x3-x4))/d;
    const u = -((x1-x2)*(y1-y3)-(y1-y2)*(x1-x3))/d;
    if (t >= 0 && t <= 1 && u >= 0 && u <= 1) {
        return { x: x1+t*(x2-x1), y: y1+t*(y2-y1) };
    }
    return null;
}

function intersectConvexPoly(polyA, polyB) {
    // Normalize polyB winding to counter-clockwise; work on a copy to avoid mutating caller data
    const normB = polygonSignedArea(polyB) < 0 ? [...polyB].reverse() : polyB;
    let out = polyA;
    for (let i = 0; i < normB.length; i++) { const a = normB[i], b = normB[(i + 1) % normB.length]; out = clipAgainstEdge(out, a, b); if (!out.length) return []; }
    return out;
}

function translatePoly(pts, cx, cy) { return pts.map(p => ({ x: p.x + cx, y: p.y + cy })); }
function rotPoly(pts, ang) { const c = Math.cos(ang), s = Math.sin(ang); return pts.map(p => ({ x: p.x * c - p.y * s, y: p.x * s + p.y * c })); }

function hexRingLocal() {
    return { outer: hexPts(HEX_S).map(p => ({ x: p.x, y: p.y })), inner: hexPts(INNER_S).map(p => ({ x: p.x, y: p.y })) };
}

function trapOuterLocal() {
    const ext = hexPts(HEX_S);
    return [{ x: ext[0].x, y: ext[0].y }, { x: ext[1].x, y: ext[1].y }, { x: ext[2].x, y: ext[2].y }, { x: ext[3].x, y: ext[3].y }, { x: ext[0].x, y: ext[3].y }];
}

function trapInnerLocal() {
    const ext = hexPts(HEX_S), inn = hexPts(INNER_S), hy = ext[3].y + WALL;
    return [{ x: inn[0].x - WALL / 2, y: hy }, { x: inn[3].x + WALL / 2, y: hy }, { x: inn[2].x, y: inn[2].y }, { x: inn[1].x, y: inn[1].y }, { x: inn[0].x, y: inn[0].y }];
}

function pentaOuterLocal() {
    const ext = hexPts(HEX_S);
    return [{ x: 0, y: ext[1].y }, { x: ext[1].x, y: ext[1].y }, { x: ext[0].x, y: ext[0].y }, { x: ext[5].x, y: ext[5].y }, { x: 0, y: ext[5].y }];
}

function pentaInnerLocal() {
    const inn = hexPts(INNER_S);
    return [{ x: WALL, y: inn[5].y }, { x: inn[5].x, y: inn[5].y }, { x: inn[0].x, y: inn[0].y }, { x: inn[1].x, y: inn[1].y }, { x: WALL, y: inn[1].y }];
}

function quartOuterLocal(q) {
    const ext = hexPts(HEX_S);
    if (q === 0) return [{ x: 0, y: 0 }, { x: ext[0].x, y: ext[0].y }, { x: ext[1].x, y: ext[1].y }, { x: 0, y: ext[1].y }];
    if (q === 1) return [{ x: 0, y: ext[1].y }, { x: -ext[1].x, y: ext[1].y }, { x: -ext[0].x, y: ext[0].y }, { x: 0, y: 0 }];
    if (q === 2) return [{ x: 0, y: 0 }, { x: -ext[0].x, y: -ext[0].y }, { x: -ext[1].x, y: -ext[1].y }, { x: 0, y: -ext[1].y }];
    return [{ x: 0, y: -ext[1].y }, { x: ext[1].x, y: -ext[1].y }, { x: ext[0].x, y: -ext[0].y }, { x: 0, y: 0 }];
}

function quartInnerLocal(q) {
    const inn = hexPts(INNER_S), hy = WALL;
    if (q === 0) return [{ x: inn[0].x - WALL / 2, y: hy }, { x: WALL, y: hy }, { x: WALL, y: inn[1].y }, { x: inn[1].x, y: inn[1].y }, { x: inn[0].x, y: inn[0].y }];
    if (q === 1) return [{ x: -inn[0].x, y: inn[0].y }, { x: -inn[1].x, y: inn[1].y }, { x: -WALL, y: inn[1].y }, { x: -WALL, y: hy }, { x: -(inn[0].x - WALL / 2), y: hy }];
    if (q === 2) return [{ x: -(inn[0].x - WALL / 2), y: -hy }, { x: -WALL, y: -hy }, { x: -WALL, y: -inn[1].y }, { x: -inn[1].x, y: -inn[1].y }, { x: -inn[0].x, y: -inn[0].y }];
    return [{ x: inn[0].x - WALL / 2, y: -hy }, { x: WALL, y: -hy }, { x: WALL, y: -inn[1].y }, { x: inn[1].x, y: -inn[1].y }, { x: inn[0].x, y: -inn[0].y }];
}

function worldFootprint(concreteType, q, r) {
    const { x: cx, y: cy } = cellPos(q, r);
    const off = pts => translatePoly(pts, cx, cy);

    if (concreteType === 'add' || concreteType === 'hex') { const { outer, inner } = hexRingLocal(); return { kind: 'ring', outer: off(outer), inner: off(inner) }; }
    if (concreteType === 'hexFull' || concreteType === 'hexFixFull') return { kind: 'solid', poly: off(hexRingLocal().outer) };

    let m = concreteType.match(/^(trap|trapFix)_(\d+)$/);
    if (m) { const s = +m[2], ang = sectorAngle(s); return { kind: 'ring', outer: off(rotPoly(trapOuterLocal(), ang)), inner: off(rotPoly(trapInnerLocal(), ang)) }; }
    if (concreteType.startsWith('trapFull_')) { const s = +concreteType.slice(9), ang = sectorAngle(s); return { kind: 'solid', poly: off(rotPoly(trapOuterLocal(), ang)) }; }

    m = concreteType.match(/^(penta|pentaFix)_(\d+)$/);
    if (m) { const c = +m[2], ang = c * DEG60; return { kind: 'solid', poly: off(rotPoly(pentaOuterLocal(), ang)) }; }
    if (concreteType.startsWith('pentaFull_')) { const c = +concreteType.slice(10), ang = c * DEG60; return { kind: 'solid', poly: off(rotPoly(pentaOuterLocal(), ang)) }; }

    m = concreteType.match(/^(quart|quartFix)_(\d+)$/);
    if (m) { const qi = +m[2]; return { kind: 'ring', outer: off(quartOuterLocal(qi)), inner: off(quartInnerLocal(qi)) }; }
    if (concreteType.startsWith('quartFull_')) { const qi = +concreteType.slice(10); return { kind: 'solid', poly: off(quartOuterLocal(qi)) }; }

    m = concreteType.match(/^(tri|triFull|triFix)_(\d+)$/);
    if (m) { const ti = +m[2]; return { kind: 'solid', poly: off(triOuterLocal(ti)) }; }

    m = concreteType.match(/^(tiers|tiersFix)_(\d+)$/);
    if (m) { const ti = +m[2]; return { kind: 'solid', poly: off(tiersOuterLocal(ti)) }; }
    if (concreteType.startsWith('tiersFull_')) { const ti = +concreteType.slice(10); return { kind: 'solid', poly: off(tiersOuterLocal(ti)) }; }

    m = concreteType.match(/^diamond_(\d+)$/);
    if (m) { const s = +m[1], ang = (s * 60 - 60 + 360) % 360; return { kind: 'ring', outer: off(diamondOuterLocal(ang)), inner: off(diamondInnerLocal(ang)) }; }
    if (concreteType.startsWith('diamondFix_')) { const s = +concreteType.slice(11), ang = (s * 60 - 60 + 360) % 360; return { kind: 'solid', poly: off(diamondOuterLocal(ang)) }; }
    if (concreteType.startsWith('diamondFull_')) { const s = +concreteType.slice(12), ang = (s * 60 - 60 + 360) % 360; return { kind: 'solid', poly: off(diamondOuterLocal(ang)) }; }

    m = concreteType.match(/^eclat_(\d+)$/);
    if (m) { const s = +m[1], ang = (s * 60 - 60 + 360) % 360; return { kind: 'solid', poly: off(eclatOuterLocal(ang)) }; }
    if (concreteType.startsWith('eclatFix_'))  { const s = +concreteType.slice(9),  ang = (s * 60 - 60 + 360) % 360; return { kind: 'solid', poly: off(eclatOuterLocal(ang)) }; }
    if (concreteType.startsWith('eclatFull_')) { const s = +concreteType.slice(10), ang = (s * 60 - 60 + 360) % 360; return { kind: 'solid', poly: off(eclatOuterLocal(ang)) }; }

    return { kind: 'none' };
}

function overlapAreaBetween(footA, footB, skipCornerIntrusion=false) {
    if (!footA || !footB || footA.kind === 'none' || footB.kind === 'none') return 0;
    const ringSolid = (outer, inner, solid) => { const o = intersectConvexPoly(solid, outer); const i = intersectConvexPoly(solid, inner); return Math.max(0, polygonArea(o) - polygonArea(i)); };
    if (footA.kind === 'solid' && footB.kind === 'solid') return polygonArea(intersectConvexPoly(footA.poly, footB.poly));
    if (footA.kind === 'ring' && footB.kind === 'solid') return ringSolid(footA.outer, footA.inner, footB.poly);
    if (footA.kind === 'solid' && footB.kind === 'ring') return ringSolid(footB.outer, footB.inner, footA.poly);
    if (footA.kind === 'ring' && footB.kind === 'ring') {
        const oaOb = polygonArea(intersectConvexPoly(footA.outer, footB.outer)), oaIb = polygonArea(intersectConvexPoly(footA.outer, footB.inner)), iaOb = polygonArea(intersectConvexPoly(footA.inner, footB.outer)), iaIb = polygonArea(intersectConvexPoly(footA.inner, footB.inner));
        const result = Math.max(0, oaOb - oaIb - iaOb + iaIb);
        // Check if any corner of A's outer polygon lies inside B's inner polygon
        // This catches the case where a trapezoid corner intrudes into another's hollow
        // Use a small tolerance to catch corners that are very close to the inner polygon boundary
        // NOTE: skipped for diamond-vs-diamond because all diamond polygons share (0,0) as a vertex,
        // which always falsely triggers this check even for non-overlapping orientations.
        let cornerIntrusion = 0;
        let cornerDebug = '';
        const cornerTolerance = WALL * 0.3;
        if (!skipCornerIntrusion && footA.outer && footB.inner) {
            for (let i = 0; i < footA.outer.length; i++) {
                const pt = footA.outer[i];
                // Check if point is inside or very close to the inner polygon
                const inside = pointInsideConvexPoly(pt.x, pt.y, footB.inner, -cornerTolerance);
                if (inside) {
                    cornerIntrusion = 1;
                    cornerDebug = `A_outer[${i}](${pt.x.toFixed(2)},${pt.y.toFixed(2)}) inside B_inner`;
                    break;
                }
            }
        }
        if (!skipCornerIntrusion && !cornerIntrusion && footB.outer && footA.inner) {
            for (let i = 0; i < footB.outer.length; i++) {
                const pt = footB.outer[i];
                const inside = pointInsideConvexPoly(pt.x, pt.y, footA.inner, -cornerTolerance);
                if (inside) {
                    cornerIntrusion = 1;
                    cornerDebug = `B_outer[${i}](${pt.x.toFixed(2)},${pt.y.toFixed(2)}) inside A_inner`;
                    break;
                }
            }
        }
        const finalResult = Math.max(result, cornerIntrusion);

        return finalResult;
    }
    return 0;
}

function collectOverlapSlotKeys(candFoot, candType) {
    const keys = [];
    const isAnyDiamond = (type) => type && (type.includes('diamond') || type.includes('eclat'));
    elements.forEach((mesh, sk) => {
        const t = elementTypes.get(sk), { q: eq, r: er } = mesh.userData;
        const label = null;
        const otherFoot = worldFootprint(t, eq, er);
        const skipCorner = isAnyDiamond(candType) && isAnyDiamond(t);
        const overlap = overlapAreaBetween(candFoot, otherFoot, skipCorner);
        if (overlap > OVERLAP_EPS) {
            keys.push(sk);
        }
    });
    return keys;
}

function getSector(dx, dy) { let a = Math.atan2(dy, dx) * 180 / Math.PI; if (a < 0) a += 360; return Math.floor(a / 60) % 6; }
function getCorner(dx, dy) { let a = Math.atan2(dy, dx) * 180 / Math.PI; if (a < 0) a += 360; return Math.floor(a / 60) % 6; }
function getTriSector(dx, dy) { let a = Math.atan2(dy, dx) * 180 / Math.PI; if (a < 0) a += 360; return Math.floor(a / 60) % 6; }
function getDiamondSector(dx, dy) { let a = Math.atan2(dy, dx) * 180 / Math.PI; if (a < 0) a += 360; return Math.floor(a / 60) % 6; }
function getQuart(dx, dy) { if (dx >= 0 && dy >= 0) return 0; if (dx < 0 && dy >= 0) return 1; if (dx < 0 && dy < 0) return 2; return 3; }

function occupiedSlots(q, r) { return ALL_SLOTS.filter(s => elements.has(slotKey(q, r, s))); }

function resolveType(tool, hitPt, cellPos) {
    const dx = hitPt.x - cellPos.x, dy = hitPt.y - cellPos.y;
    if (tool === 'trap')      return `trap_${getSector(dx, dy)}`;
    if (tool === 'trapFix')   return `trapFix_${getSector(dx, dy)}`;
    if (tool === 'trapFull')  return `trapFull_${getSector(dx, dy)}`;
    if (tool === 'penta')     return `penta_${getCorner(dx, dy)}`;
    if (tool === 'pentaFix')  return `pentaFix_${getCorner(dx, dy)}`;
    if (tool === 'pentaFull') return `pentaFull_${getCorner(dx, dy)}`;
    if (tool === 'quart')     return `quart_${getQuart(dx, dy)}`;
    if (tool === 'quartFix')  return `quartFix_${getQuart(dx, dy)}`;
    if (tool === 'quartFull') return `quartFull_${getQuart(dx, dy)}`;
    if (tool === 'tri')        return `tri_${getTriSector(dx, dy)}`;
    if (tool === 'triFull')    return `triFull_${getTriSector(dx, dy)}`;
    if (tool === 'triFix')     return `triFix_${getTriSector(dx, dy)}`;
    if (tool === 'diamond')    return `diamond_${getDiamondSector(dx, dy)}`;
    if (tool === 'diamondFull') return `diamondFull_${getDiamondSector(dx, dy)}`;
    if (tool === 'diamondFix') return `diamondFix_${getDiamondSector(dx, dy)}`;
    if (tool === 'eclat')      return `eclat_${getDiamondSector(dx, dy)}`;
    if (tool === 'eclatFull')  return `eclatFull_${getDiamondSector(dx, dy)}`;
    if (tool === 'eclatFix')   return `eclatFix_${getDiamondSector(dx, dy)}`;
    if (tool === 'tiers')      return `tiers_${getTriSector(dx, dy)}`;
    if (tool === 'tiersFix')   return `tiersFix_${getTriSector(dx, dy)}`;
    if (tool === 'tiersFull')  return `tiersFull_${getTriSector(dx, dy)}`;
    return tool;
}

function getResolvedType(tool, hitPt, cellPos) {
    if (lockedOrientation.has(tool)) return lockedOrientation.get(tool);
    return resolveType(tool, hitPt, cellPos);
}

function slotOf(type) { if (type === 'add') return 'hex'; return ALL_SLOTS.includes(type) ? type : null; }

const MIRROR_X_MAP_TRAP = [2, 1, 0, 5, 4, 3]; // for trap
const MIRROR_X_MAP_PENTA = [3, 2, 1, 0, 5, 4]; // for penta
const MIRROR_X_MAP_TRI = [2, 1, 0, 5, 4, 3]; // for tri
const MIRROR_X_MAP_TIERS = [1, 0, 5, 4, 3, 2]; // for tiers
const MIRROR_X_MAP_QUART = [1, 0, 3, 2]; // for quart
const MIRROR_X_MAP_ECLAT = [3, 2, 1, 0, 5, 4]; // for eclat
const MIRROR_X_MAP_DIAMOND = [2, 1, 0, 5, 4, 3]; // for diamond

const MIRROR_Y_MAP_TRAP = [5, 4, 3, 2, 1, 0]; // for trap
const MIRROR_Y_MAP_PENTA = [0, 5, 4, 3, 2, 1]; // for penta
const MIRROR_Y_MAP_TRI = [5, 4, 3, 2, 1, 0]; // for tri
const MIRROR_Y_MAP_TIERS = [4, 3, 2, 1, 0, 5]; // for tiers
const MIRROR_Y_MAP_QUART = [3, 2, 1, 0]; // for quart
const MIRROR_Y_MAP_ECLAT = [0, 5, 4, 3, 2, 1]; // for eclat
const MIRROR_Y_MAP_DIAMOND = [5, 4, 3, 2, 1, 0]; // for diamond
const QUART_MIRROR_X = [1, 0, 3, 2];
const QUART_MIRROR_Y = [3, 2, 1, 0];
const INDEXED_PREFIXES = ['trap', 'trapFix', 'trapFull', 'penta', 'pentaFix', 'pentaFull', 'tri', 'triFull', 'triFix', 'tiers', 'tiersFix', 'tiersFull', 'eclat', 'eclatFix', 'eclatFull', 'diamond', 'diamondFix', 'diamondFull'];
const QUART_PREFIXES = ['quart', 'quartFix', 'quartFull'];

function remapIndexedType(type, axis) {
    let map;
    if (axis === 'x') {
        if (type.startsWith('trap')) map = MIRROR_X_MAP_TRAP;
        else if (type.startsWith('penta')) map = MIRROR_X_MAP_PENTA;
        else if (type.startsWith('tri')) map = MIRROR_X_MAP_TRI;
        else if (type.startsWith('tiers')) map = MIRROR_X_MAP_TIERS;
        else if (type.startsWith('quart')) map = MIRROR_X_MAP_QUART;
        else if (type.startsWith('eclat')) map = MIRROR_X_MAP_ECLAT;
        else if (type.startsWith('diamond')) map = MIRROR_X_MAP_DIAMOND;
        else map = MIRROR_X_MAP_PENTA; // default
    } else {
        if (type.startsWith('trap')) map = MIRROR_Y_MAP_TRAP;
        else if (type.startsWith('penta')) map = MIRROR_Y_MAP_PENTA;
        else if (type.startsWith('tri')) map = MIRROR_Y_MAP_TRI;
        else if (type.startsWith('tiers')) map = MIRROR_Y_MAP_TIERS;
        else if (type.startsWith('quart')) map = MIRROR_Y_MAP_QUART;
        else if (type.startsWith('eclat')) map = MIRROR_Y_MAP_ECLAT;
        else if (type.startsWith('diamond')) map = MIRROR_Y_MAP_DIAMOND;
        else map = MIRROR_Y_MAP_PENTA; // default
    }
    for (const prefix of QUART_PREFIXES) {
        const stem = `${prefix}_`;
        if (!type.startsWith(stem)) continue;
        const n = Number(type.slice(stem.length));
        if (!Number.isInteger(n) || n < 0 || n > 3) return type;
        const qmap = axis === 'x' ? QUART_MIRROR_X : QUART_MIRROR_Y;
        return `${prefix}_${qmap[n]}`;
    }
    for (const prefix of INDEXED_PREFIXES) {
        const stem = `${prefix}_`;
        if (!type.startsWith(stem)) continue;
        const n = Number(type.slice(stem.length));
        if (!Number.isInteger(n) || n < 0 || n > 5) return type;
        return `${prefix}_${map[n]}`;
    }
    return type;
}

function canPlace(q, r, type) { if (type === 'remove') return false; return true; }

const ELEM_MAT = new THREE.MeshStandardMaterial({ color:0xf39c12, roughness:.3, metalness:.1, emissive:0xf39c12, emissiveIntensity:.04 });
const PREVIEW_MAT = new THREE.MeshStandardMaterial({ color:0xf39c12, roughness:.3, metalness:.1, transparent:true, opacity:0.28, depthWrite:false });
let previewMesh = null;
const threatenedMeshes = new Set();

function clearThreatHighlights() {
    threatenedMeshes.forEach(mesh => {
        const mat = mesh.material, orig = mesh.userData?.threatOrig;
        if (mat && orig) { mat.color.setHex(orig.color); mat.emissive.setHex(orig.emissive); mat.emissiveIntensity = orig.emissiveIntensity; }
    });
    threatenedMeshes.clear();
}

function markThreatenedAt(q, r, concreteType) {
    clearThreatHighlights();
    if (concreteType === 'remove') {
        // For remove, highlight pieces at the hovered cell
        elements.forEach((mesh, sk) => {
            const { q: eq, r: er } = mesh.userData;
            if (eq === q && er === r) {
                const mat = mesh.material;
                if (!mat || !mat.color || !mat.emissive) return;
                if (!mesh.userData.threatOrig) mesh.userData.threatOrig = { color: mat.color.getHex(), emissive: mat.emissive.getHex(), emissiveIntensity: mat.emissiveIntensity };
                mat.color.setHex(0xff6b6b); mat.emissive.setHex(0xff0000); mat.emissiveIntensity = 0.35;
                threatenedMeshes.add(mesh);
            }
        });
        return;
    }
    const candFoot = worldFootprint(concreteType, q, r);
    const isAnyDiamond = (type) => type && (type.includes('diamond') || type.includes('eclat'));
    elements.forEach((mesh, sk) => {
        const t = elementTypes.get(sk), { q: eq, r: er } = mesh.userData;
        const skipCorner = isAnyDiamond(concreteType) && isAnyDiamond(t);
        const overlap = overlapAreaBetween(candFoot, worldFootprint(t, eq, er), null, skipCorner);
        if (overlap <= OVERLAP_EPS) return;
        const mat = mesh.material;
        if (!mat || !mat.color || !mat.emissive) return;
        if (!mesh.userData.threatOrig) mesh.userData.threatOrig = { color: mat.color.getHex(), emissive: mat.emissive.getHex(), emissiveIntensity: mat.emissiveIntensity };
        mat.color.setHex(0xff6b6b); mat.emissive.setHex(0xff0000); mat.emissiveIntensity = 0.35;
        threatenedMeshes.add(mesh);
    });
}

function mirrorDesign(axis, isUndo = false) {
    if (!elements.size) return;
    if (axis === 'z') { setShoulder(shoulderDir === 'back' ? 'front' : 'back'); hidePreview(); if (currentMouseE) updatePreview(currentMouseE); return; }
    const mapped = [];
    const layerMap = new Map();
    elements.forEach((mesh, sk) => {
        const t = elementTypes.get(sk), {q, r} = mesh.userData;
        let nq = q, nr = r, nt = t;
        if (axis === 'x') { nq = -q; nt = remapIndexedType(t, 'x'); }
        else if (axis === 'y') { nr = (q % 2 === 0) ? -r : (-r - 1); nt = remapIndexedType(t, 'y'); }
        const newSk = slotKey(nq, nr, slotOf(nt));
        mapped.push({q: nq, r: nr, type: nt, newSk});
        layerMap.set(newSk, pieceToLayer.get(sk) || 'default');
    });
    elements.forEach(m => { scene.remove(m); m.geometry.dispose(); });
    elements.clear(); elementTypes.clear();
    pieceToLayer.clear();
    borderMeshes.forEach(m => { scene.remove(m); m.geometry.dispose(); }); borderMeshes.clear();
    mapped.forEach(({q, r, type, newSk}) => {
        const prevLayer = activeLayerId;
        const targetLayer = layerMap.get(newSk) || 'default';
        activeLayerId = targetLayer;
        placeElement(q, r, type);
        activeLayerId = prevLayer;
    });
    if (!isUndo) undoStack.push({ type: 'mirror', axis });
    updateStats(); hidePreview(); if (currentMouseE) updatePreview(currentMouseE);
}

