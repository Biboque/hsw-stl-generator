document.getElementById('viewToggleBtn').addEventListener('click', () => toggleView());

init();
animate();

// ─── Init ────────────────────────────────────────────────────────────────────
function cellPos(q, r) { return { x: q*HEX_S*1.5, y: r*HEX_H + (q%2 ? HEX_H/2 : 0) }; }

function pointToCell(x, y) {
    let minDist = Infinity;
    let bestQ = 0, bestR = 0;
    for (let q = -20; q < 20; q++) {
        for (let r = -14; r < 14; r++) {
            const {x: cx, y: cy} = cellPos(q, r);
            const dist = Math.hypot(x - cx, y - cy);
            if (dist < minDist) {
                minDist = dist;
                bestQ = q;
                bestR = r;
            }
        }
    }
    return {q: bestQ, r: bestR};
}

function init() {
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0d0d0d);
    const W = window.innerWidth-300, H = window.innerHeight;
    camera = new THREE.PerspectiveCamera(60, W/H, 0.1, 2000);
    camera.position.set(0, 0, 280);
    const oh=280, asp=W/H;
    orthoCamera = new THREE.OrthographicCamera(-oh*asp, oh*asp, oh, -oh, 0.1, 5000);
    orthoCamera.position.set(0, 0, 500); orthoCamera.lookAt(0, 0, 0);
    renderer = new THREE.WebGLRenderer({antialias:true});
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.setSize(W, H);
    document.getElementById('canvas-container').appendChild(renderer.domElement);
    document.getElementById('canvas-container').setAttribute('data-tool', activeTool);
    controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true; controls.dampingFactor = 0.08;
    const dl1 = new THREE.DirectionalLight(0xffffff, 1.5); dl1.position.set(10,20,30); scene.add(dl1);
    const dl2 = new THREE.DirectionalLight(0xffffff, 0.4); dl2.position.set(-10,-10,10); scene.add(dl2);
    scene.add(new THREE.AmbientLight(0x444444));
    // Create default layer
    layers.set('default', {
        name: 'Groupe 1',
        visible: true,
        locked: false,
        order: 0,
        color: new THREE.Color(0xf39c12)
    });
    buildGrid();
    bindEvents();
    renderLayersList();
}

function buildGrid() {
    const hr = HEX_S * 0.97;
    const pts2D = Array.from({length:6}, (_,i) => new THREE.Vector2(hr*Math.cos(i*DEG60), hr*Math.sin(i*DEG60)));
    const pts3D = [...pts2D.map(p => new THREE.Vector3(p.x, p.y, 0)), new THREE.Vector3(hr, 0, 0)];
    const guideGeo = new THREE.BufferGeometry().setFromPoints(pts3D);
    const guideMat = new THREE.LineBasicMaterial({color:0x2a2a32, transparent:true, opacity:0.9});
    const hitGeo = new THREE.ShapeGeometry(new THREE.Shape(pts2D));
    const hitMat = new THREE.MeshBasicMaterial({side:THREE.DoubleSide, visible:false});
    for (let q=-20; q<20; q++) {
        for (let r=-14; r<14; r++) {
            const {x,y} = cellPos(q,r);
            const guide = new THREE.Line(guideGeo, guideMat); guide.position.set(x, y, -0.5); scene.add(guide); gridLines.push(guide);
            const hit = new THREE.Mesh(hitGeo, hitMat); hit.position.set(x, y, 0); hit.userData = {q, r}; scene.add(hit); hitPlanes.set(`${q},${r}`, hit);
        }
    }
}

function bindEvents() {
    const el = renderer.domElement;
    el.addEventListener('mousedown', e => {
        mouseStart.set(e.clientX, e.clientY); didDrag=false;
        if (activeTool === 'select') {
            clearThreatHighlights(); // Clear any preview highlights on mousedown
            const rect = renderer.domElement.getBoundingClientRect();
            ndcMouse.set(((e.clientX-rect.left)/rect.width)*2-1, -((e.clientY-rect.top)/rect.height)*2+1);
            const activeCam = isOrtho ? orthoCamera : camera;
            raycaster.setFromCamera(ndcMouse, activeCam);
            const elementMeshes = Array.from(elements.values());
            const elemIntersects = raycaster.intersectObjects(elementMeshes);
            
            if (elemIntersects.length > 0) {
                const hitMesh = elemIntersects[0].object;
                const sk = slotKey(hitMesh.userData.q, hitMesh.userData.r, hitMesh.userData.slot);
                if (selectedPieces.has(sk)) {
                    isDraggingGroup = true;
                    groupDragStartHitX = hitMesh.position.x;
                    groupDragStartHitY = hitMesh.position.y;
                    const startCell = pointToCell(groupDragStartHitX, groupDragStartHitY);
                    groupDragStartQ = startCell.q;
                    groupDragStartR = startCell.r;
                    controls.enabled = false;
                }
            }
        } else if (activeTool === 'remove') {
            eraseAt(e);
            return;
        }
    });
    el.addEventListener('mousemove', e => {
        if (Math.hypot(e.clientX-mouseStart.x, e.clientY-mouseStart.y) > 4) didDrag=true;
        currentMouseE = e;
        if (isDraggingGroup) {
            // Handle group drag preview
            const cell = getHitCell(e);
            if (cell && cell.hitPt) {
                const currentCell = pointToCell(cell.hitPt.x, cell.hitPt.y);
                const dq = currentCell.q - groupDragStartQ;
                const dr = currentCell.r - groupDragStartR;
                updateGroupDragPreview(dq, dr);
            }
        } else if (isPainting) { startPaintBatch(); paintAt(e); } else if (isErasing) { startEraseBatch(); eraseAt(e); updatePreview(e); } else updatePreview(e);
    });
    el.addEventListener('mouseleave', () => hidePreview());
    el.addEventListener('mouseup', e => {
        if (isDraggingGroup) {
            isDraggingGroup = false;
            controls.enabled = true;
            if (didDrag) {
                const cell = getHitCell(e);
                if (cell && cell.hitPt) {
                    const currentCell = pointToCell(cell.hitPt.x, cell.hitPt.y);
                    const dq = currentCell.q - groupDragStartQ;
                    const dr = currentCell.r - groupDragStartR;
                    commitGroupMove(dq, dr);
                }
            } else {
                // Click on already selected piece without dragging - deselect specific piece
                const activeCam = isOrtho ? orthoCamera : camera;
                raycaster.setFromCamera(ndcMouse, activeCam);
                const elementMeshes = Array.from(elements.values());
                const elemIntersects = raycaster.intersectObjects(elementMeshes);
                if (elemIntersects.length > 0) {
                    const hitMesh = elemIntersects[0].object;
                    const sk = slotKey(hitMesh.userData.q, hitMesh.userData.r, hitMesh.userData.slot);
                    if (selectedPieces.has(sk)) {
                        selectedPieces.delete(sk);
                        clearPieceHighlight(sk);
                        updateGroupBtn();
                    }
                }
            }
            clearGroupDragPreview();
        } else if (!didDrag) handleClick(e);
    });
    el.addEventListener('contextmenu', e => {
        e.preventDefault();
        if (!didDrag) { startEraseBatch(); eraseAt(e); endEraseBatch(); }
    });
    window.addEventListener('keydown', e => {
        // Ctrl+Z undo — check e.key for AZERTY compatibility (Z key produces KeyW on AZERTY)
        if ((e.key === 'z' || e.key === 'Z') && (e.ctrlKey || e.metaKey)) {
            e.preventDefault();
            endPaintBatch();
            endEraseBatch();
            undoLastBatch();
            return;
        }
        // Ctrl+Y redo
        if ((e.key === 'y' || e.key === 'Y') && (e.ctrlKey || e.metaKey)) {
            e.preventDefault();
            redoLastBatch();
            return;
        }
        if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') {
            isShiftHeld = true;
            document.getElementById('shiftKey').classList.add('shift-active');
        }
        if (e.code==='Space' && !isPainting && !isErasing) { e.preventDefault(); isPainting=true; lastPaintKey=null; lastEraseKey=null; controls.enabled=false; document.getElementById('canvas-container').classList.add('painting'); document.getElementById('spaceKey').classList.add('paint-active'); if (currentMouseE) { if (isShiftHeld && !lockedOrientation.has(activeTool)) { const cell = getHitCell(currentMouseE); if (cell) { const {hitPt} = cell, cp = cellPos(cell.q, cell.r); lockedOrientation.set(activeTool, resolveType(activeTool, hitPt, cp)); } } startPaintBatch(); paintAt(currentMouseE); } }
        if ((e.code==='ControlLeft'||e.code==='ControlRight') && !isErasing && !isPainting) { e.preventDefault(); isErasing=true; lastEraseKey=null; controls.enabled=false; document.getElementById('canvas-container').classList.add('erasing'); document.getElementById('ctrlKey').classList.add('erase-active'); }
        if (e.code==='KeyF') resetView(); if (e.code==='KeyP') toggleView();
    });
    document.getElementById('undoBtn').addEventListener('click', () => { endPaintBatch(); endEraseBatch(); undoLastBatch(); });
    document.getElementById('redoBtn').addEventListener('click', () => { redoLastBatch(); });
    window.addEventListener('keyup', e => {
        if (e.code==='Space') { isPainting=false; lastPaintKey=null; endPaintBatch(); if (!isErasing) controls.enabled=true; document.getElementById('canvas-container').classList.remove('painting'); document.getElementById('spaceKey').classList.remove('paint-active'); }
        if (e.code==='ControlLeft'||e.code==='ControlRight') { isErasing=false; lastEraseKey=null; endEraseBatch(); if (!isPainting) controls.enabled=true; document.getElementById('canvas-container').classList.remove('erasing'); document.getElementById('ctrlKey').classList.remove('erase-active'); }
        if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') {
            isShiftHeld = false;
            lockedOrientation.clear();
            document.getElementById('shiftKey').classList.remove('shift-active');
        }
    });
    window.addEventListener('resize', () => {
        const W=window.innerWidth-300, H=window.innerHeight;
        if (!isOrtho) { camera.aspect=W/H; camera.updateProjectionMatrix(); } else updateOrthoSize(W, H);
        renderer.setSize(W, H);
    });
}

// ─── Raycaster / interaction ─────────────────────────────────────────────────
function getHitCell(e) {
    const rect = renderer.domElement.getBoundingClientRect();
    ndcMouse.set(((e.clientX-rect.left)/rect.width)*2-1, -((e.clientY-rect.top)/rect.height)*2+1);
    raycaster.setFromCamera(ndcMouse, isOrtho ? orthoCamera : camera);
    const hits = raycaster.intersectObjects([...hitPlanes.values()], false);
    if (!hits.length) return null;
    const {q, r} = hits[0].object.userData;
    return {q, r, hitPt: hits[0].point};
}

// ─── Preview ─────────────────────────────────────────────────────────────────
function updatePreview(e) {
    if (isPainting) { hidePreview(); return; }
    if (activeTool === 'select') {
        // Clear any previous green preview outlines
        selectionHighlights.forEach((hl, sk) => {
            if (hl.type === 'preview') {
                scene.remove(hl.outline);
                hl.outline.geometry.dispose();
                hl.outline.material.dispose();
                selectionHighlights.delete(sk);
            }
        });
        
        if (isPainting) { hidePreview(); return; } // Double-check in case state changed
        
        // Get cell under cursor
        const cell = getHitCell(e); 
        if (!cell) { 
            clearThreatHighlights(); 
            return; 
        }
        
        // Raycast against element meshes to find the piece under cursor
        const activeCam = isOrtho ? orthoCamera : camera;
        raycaster.setFromCamera(ndcMouse, activeCam);
        const elementMeshes = Array.from(elements.values());
        const elemIntersects = raycaster.intersectObjects(elementMeshes);
        
        clearThreatHighlights();
        if (elemIntersects.length > 0) {
            // Highlight only the specific mesh under cursor with green outline
            const hitMesh = elemIntersects[0].object;
            const sk = slotKey(hitMesh.userData.q, hitMesh.userData.r, hitMesh.userData.slot);
            // Only show preview outline if piece is not already selected
            if (!selectedPieces.has(sk)) {
                const geo = hitMesh.geometry;
                if (geo) {
                    const edgesGeo = new THREE.EdgesGeometry(geo);
                    const lineMat = new THREE.LineBasicMaterial({ color: 0x00ff00, transparent: true, opacity: 0.9 });
                    const outline = new THREE.LineSegments(edgesGeo, lineMat);
                    outline.position.copy(hitMesh.position);
                    outline.rotation.copy(hitMesh.rotation);
                    outline.scale.copy(hitMesh.scale).multiplyScalar(1.02);
                    outline.renderOrder = 999;
                    scene.add(outline);
                    selectionHighlights.set(sk, { outline, type: 'preview' });
                }
            }
        }
        return;
    }
    if (activeTool === 'remove' || isErasing) {
        const cell = getHitCell(e); if (!cell) { hidePreview(); return; }
        const {q, r} = cell;
        // Raycast against element meshes for precise slot-level highlighting
        const activeCam = isOrtho ? orthoCamera : camera;
        raycaster.setFromCamera(ndcMouse, activeCam);
        const elementMeshes = Array.from(elements.values());
        const elemIntersects = raycaster.intersectObjects(elementMeshes);
        
        clearThreatHighlights();
        if (elemIntersects.length > 0) {
            // Highlight only the specific mesh under cursor
            const hitMesh = elemIntersects[0].object;
            const mat = hitMesh.material;
            if (mat && mat.color && mat.emissive) {
                if (!hitMesh.userData.threatOrig) hitMesh.userData.threatOrig = { color: mat.color.getHex(), emissive: mat.emissive.getHex(), emissiveIntensity: mat.emissiveIntensity };
                mat.color.setHex(0xff6b6b); mat.emissive.setHex(0xff0000); mat.emissiveIntensity = 0.35;
                threatenedMeshes.add(hitMesh);
            }
        } else {
            // Fallback: highlight all meshes in this cell
            const slots = occupiedSlots(q, r);
            if (slots.length === 0) { hidePreview(); return; }
            for (const slot of slots) {
                const sk = slotKey(q, r, slot);
                const m = elements.get(sk);
                if (m) {
                    const mat = m.material;
                    if (!mat || !mat.color || !mat.emissive) continue;
                    if (!m.userData.threatOrig) m.userData.threatOrig = { color: mat.color.getHex(), emissive: mat.emissive.getHex(), emissiveIntensity: mat.emissiveIntensity };
                    mat.color.setHex(0xff6b6b); mat.emissive.setHex(0xff0000); mat.emissiveIntensity = 0.35;
                    threatenedMeshes.add(m);
                }
            }
        }
        return;
    }
    const cell = getHitCell(e); if (!cell) { hidePreview(); return; }
    const {q, r, hitPt} = cell, cp = cellPos(q, r);
    if (e.shiftKey && !lockedOrientation.has(activeTool)) {
        lockedOrientation.set(activeTool, resolveType(activeTool, hitPt, cp));
    }
    const concreteType = getResolvedType(activeTool, hitPt, cp), slot = slotOf(concreteType);
    const existingSk = slotKey(q, r, slot);
    const existingMesh = elements.get(existingSk);
    // If there's an existing mesh at this slot, mark it as threatened (red preview)
    if (existingMesh) {
        clearThreatHighlights();
        const mat = existingMesh.material;
        if (mat && mat.color && mat.emissive) {
            if (!existingMesh.userData.threatOrig) existingMesh.userData.threatOrig = { color: mat.color.getHex(), emissive: mat.emissive.getHex(), emissiveIntensity: mat.emissiveIntensity };
            mat.color.setHex(0xff6b6b); mat.emissive.setHex(0xff0000); mat.emissiveIntensity = 0.35;
            threatenedMeshes.add(existingMesh);
        }
    }
    // Also mark threatened pieces that would be overlapped
    markThreatenedAt(q, r, concreteType);
    const geo = buildGeometry(concreteType);
    if (!previewMesh) { previewMesh = new THREE.Mesh(geo, PREVIEW_MAT); scene.add(previewMesh); } else { previewMesh.geometry.dispose(); previewMesh.geometry = geo; }
    previewMesh.position.set(cp.x, cp.y, 0.1); previewMesh.visible = true;
}

function hidePreview() { clearThreatHighlights(); if (previewMesh) previewMesh.visible = false; }

function removeSlot(sk) {
    clearPieceHighlight(sk);
    const m = elements.get(sk);
    if (m) { const { q, r } = m.userData; threatenedMeshes.delete(m); scene.remove(m); elements.delete(sk); elementTypes.delete(sk); pieceToLayer.delete(sk); removeBorderMesh(sk); refreshNeighborBorders(q, r); } else { removeBorderMesh(sk); }
}

function removeAllSlotsAt(q, r) { ALL_SLOTS.forEach(s => removeSlot(slotKey(q, r, s))); }

function placeElement(q, r, concreteType) {
    if (!concreteType || concreteType === 'remove') return;
    const slot = slotOf(concreteType); if (!slot) return; if (!canPlace(q, r, concreteType)) return;
    const candFoot = worldFootprint(concreteType, q, r);
    collectOverlapSlotKeys(candFoot, concreteType).forEach(sk => removeSlot(sk));
    const sk = slotKey(q, r, slot);
    const geo = buildGeometry(concreteType);
    if (!geo) return;
    const mesh = new THREE.Mesh(geo, ELEM_MAT.clone());
    const {x,y} = cellPos(q,r); mesh.position.set(x, y, 0); mesh.userData = {q, r, slot};
    scene.add(mesh); elements.set(sk, mesh); elementTypes.set(sk, concreteType);
    pieceToLayer.set(sk, activeLayerId);
    const layer = layers.get(activeLayerId);
    if (layer) {
        mesh.material.color.set(layer.color);
        mesh.material.emissive.set(layer.color);
        mesh.material.emissiveIntensity = 0.04;
        if (!layer.visible) mesh.visible = false;
    }
    if (showBorder) addBorderMesh(sk, concreteType, q, r);
    refreshNeighborBorders(q, r);
}

function handleClick(e) {
    if (isDemoLoaded && !hasInteracted) {
        clearAll();
        hasInteracted = true;
        isDemoLoaded = false;
        return;
    }
    const cell = getHitCell(e); if (!cell) return;
    const {q, r, hitPt} = cell;
    // Selection tool: click to select/deselect specific piece
    if (activeTool === 'select') {
        const activeCam = isOrtho ? orthoCamera : camera;
        raycaster.setFromCamera(ndcMouse, activeCam);
        const elementMeshes = Array.from(elements.values());
        const elemIntersects = raycaster.intersectObjects(elementMeshes);
        
        if (elemIntersects.length > 0) {
            const hitMesh = elemIntersects[0].object;
            const sk = slotKey(hitMesh.userData.q, hitMesh.userData.r, hitMesh.userData.slot);
            const layerId = pieceToLayer.get(sk);
            if (layerId && layers.get(layerId)?.locked) return;
            
            // Remove any preview outline for this piece before processing selection
            const existingHL = selectionHighlights.get(sk);
            if (existingHL && existingHL.type === 'preview') {
                scene.remove(existingHL.outline);
                existingHL.outline.geometry.dispose();
                existingHL.outline.material.dispose();
                selectionHighlights.delete(sk);
            }
            
            if (selectedPieces.has(sk)) {
                selectedPieces.delete(sk);
                clearPieceHighlight(sk);
            } else {
                selectedPieces.add(sk);
                highlightSinglePiece(sk);
            }
        } else {
            selectedPieces.clear();
            clearAllHighlights();
        }
        updateGroupBtn();
        return;
    }
    // Shift+click: multi-select mode (when not in select tool)
    if (e.shiftKey) {
        const slots = occupiedSlots(q, r);
        if (slots.length > 0) {
            for (const slot of slots) {
                const sk = slotKey(q, r, slot);
                const layerId = pieceToLayer.get(sk);
                if (layerId && layers.get(layerId)?.locked) continue;
                if (selectedPieces.has(sk)) {
                    selectedPieces.delete(sk);
                    clearPieceHighlight(sk);
                } else {
                    selectedPieces.add(sk);
                    highlightSinglePiece(sk);
                }
            }
        } else {
            selectedPieces.clear();
            clearAllHighlights();
        }
        updateGroupBtn();
        return;
    }
    if (activeTool === 'remove') {
        const slots = occupiedSlots(q, r);
        if (slots.length === 0) return;
        for (const sk of slots) {
            const m = elements.get(sk);
            if (m) {
                const type = elementTypes.get(sk);
                const layerId = pieceToLayer.get(sk);
                if (layerId && layers.get(layerId)?.locked) continue;
                recordEraseAction(sk, q, r, type);
            }
        }
        const toRemove = slots.filter(sk => {
            const layerId = pieceToLayer.get(sk);
            return !layerId || !layers.get(layerId)?.locked;
        });
        toRemove.forEach(sk => removeSlot(sk));
        updateStats();
        return;
    }
    const cp = cellPos(q, r), concreteType = getResolvedType(activeTool, hitPt, cp), slot = slotOf(concreteType), sk = slotKey(q, r, slot);
    if (elements.has(sk)) {
        const layerId = pieceToLayer.get(sk);
        if (layerId && layers.get(layerId)?.locked) return;
        const type = elementTypes.get(sk);
        recordEraseAction(sk, q, r, type);
        removeSlot(sk);
    } else {
        const layer = layers.get(activeLayerId);
        if (layer && layer.locked) return;
        placeElement(q, r, concreteType);
        recordPaintAction(sk, q, r, concreteType);
    }
    updateStats(); updatePreview(e);
}

// ─── Undo/Redo system (batch-aware) ───────────────────────────────────────────
const MAX_UNDO_STEPS = 100;
let undoStack = [];
let redoStack = [];
let paintBatchActions = [];
let eraseBatchActions = [];
let inPaintBatch = false;
let inEraseBatch = false;

function trimUndoStack(stack) {
    while (stack.length > MAX_UNDO_STEPS) stack.shift();
}

function startPaintBatch() { if (!inPaintBatch) { inPaintBatch = true; paintBatchActions = []; } }
function startEraseBatch() { if (!inEraseBatch) { inEraseBatch = true; eraseBatchActions = []; } }

function endPaintBatch() {
    if (!inPaintBatch) return;
    inPaintBatch = false;
    if (paintBatchActions.length > 0) { undoStack.push({ type: 'paint', actions: [...paintBatchActions] }); trimUndoStack(undoStack); }
    paintBatchActions = [];
}

function endEraseBatch() {
    if (!inEraseBatch) return;
    inEraseBatch = false;
    if (eraseBatchActions.length > 0) { undoStack.push({ type: 'erase', actions: [...eraseBatchActions] }); trimUndoStack(undoStack); }
    eraseBatchActions = [];
}

function recordPaintAction(sk, q, r, type) {
    const action = { sk, q, r, type };
    if (inPaintBatch) paintBatchActions.push(action);
    else { undoStack.push({ type: 'paint', actions: [action] }); trimUndoStack(undoStack); }
}

function recordEraseAction(sk, q, r, type) {
    const action = { sk, q, r, type };
    if (inEraseBatch) eraseBatchActions.push(action);
    else { undoStack.push({ type: 'erase', actions: [action] }); trimUndoStack(undoStack); }
}

function undoLastBatch() {
    if (undoStack.length === 0) return;
    const batch = undoStack.pop();
    if (batch.type === 'mirror') {
        mirrorDesign(batch.axis, true);
        redoStack.push(batch);
        updateStats();
        return;
    }
    redoStack.push(batch);
    if (batch.type === 'paint') {
        for (const action of batch.actions) {
            removeSlot(action.sk);
        }
        refreshAllNeighborBorders(batch.actions);
    } else if (batch.type === 'erase') {
        for (const action of batch.actions) {
            const geo = buildGeometry(action.type);
            if (!geo) continue;
            const candFoot = worldFootprint(action.type, action.q, action.r);
            collectOverlapSlotKeys(candFoot, action.type).forEach(sk => { if (sk !== action.sk) removeSlot(sk); });
            const mesh = new THREE.Mesh(geo, ELEM_MAT.clone());
            const { x, y } = cellPos(action.q, action.r);
            mesh.position.set(x, y, 0);
            mesh.userData = { q: action.q, r: action.r, slot: slotOf(action.type) };
            scene.add(mesh);
            elements.set(action.sk, mesh);
            elementTypes.set(action.sk, action.type);
            if (showBorder) addBorderMesh(action.sk, action.type, action.q, action.r);
        }
        refreshAllNeighborBorders(batch.actions);
    } else if (batch.type === 'layer-create') {
        layers.delete(batch.layerId);
        activeLayerId = 'default';
    } else if (batch.type === 'layer-delete') {
        layers.set(batch.layerId, {
            name: batch.layerData.name,
            visible: batch.layerData.visible,
            locked: batch.layerData.locked,
            order: batch.layerData.order,
            color: new THREE.Color(batch.layerData.color)
        });
        for (const { sk, oldLayerId } of batch.movedPieces) {
            pieceToLayer.set(sk, batch.layerId);
            applyLayerColorToPiece(sk, batch.layerId);
            applyLayerVisibilityToPiece(sk, batch.layerId);
        }
    } else if (batch.type === 'layer-group') {
        layers.delete(batch.newId);
        for (const { sk, oldLayerId } of batch.movedPieces) {
            pieceToLayer.set(sk, oldLayerId);
            applyLayerColorToPiece(sk, oldLayerId);
            applyLayerVisibilityToPiece(sk, oldLayerId);
        }
        activeLayerId = 'default';
    } else if (batch.type === 'layer-duplicate') {
        layers.delete(batch.newId);
        for (const { sk, oldLayerId } of batch.movedPieces) {
            pieceToLayer.set(sk, oldLayerId);
            applyLayerColorToPiece(sk, oldLayerId);
            applyLayerVisibilityToPiece(sk, oldLayerId);
        }
    } else if (batch.type === 'layer-merge') {
        const srcData = batch.sourceData || { name: 'Merged', visible: true, locked: false, order: 0, color: '#f39c12' };
        layers.set(batch.sourceId, {
            name: srcData.name,
            visible: srcData.visible,
            locked: srcData.locked,
            order: srcData.order,
            color: new THREE.Color(srcData.color)
        });
        for (const { sk, oldLayerId } of batch.movedPieces) {
            pieceToLayer.set(sk, batch.sourceId);
            applyLayerColorToPiece(sk, batch.sourceId);
            applyLayerVisibilityToPiece(sk, batch.sourceId);
        }
    } else if (batch.type === 'layer-rename') {
        const layer = layers.get(batch.layerId);
        if (layer) layer.name = batch.oldName;
    } else if (batch.type === 'layer-color') {
        const layer = layers.get(batch.layerId);
        if (layer) {
            layer.color.set(batch.oldColor);
            for (const [sk, lid] of pieceToLayer) {
                if (lid === batch.layerId) applyLayerColorToPiece(sk, batch.layerId);
            }
        }
    } else if (batch.type === 'layer-visibility') {
        const layer = layers.get(batch.layerId);
        if (layer) {
            layer.visible = batch.oldVisible;
            for (const [sk, lid] of pieceToLayer) {
                if (lid === batch.layerId) applyLayerVisibilityToPiece(sk, batch.layerId);
            }
        }
    } else if (batch.type === 'layer-lock') {
        const layer = layers.get(batch.layerId);
        if (layer) layer.locked = batch.oldLocked;
    } else if (batch.type === 'layer-reorder') {
        const layer = layers.get(batch.layerId);
        const targetLayer = [...layers.values()].find(l => l.order === batch.newOrder);
        if (layer) layer.order = batch.oldOrder;
        if (targetLayer && targetLayer !== layer) targetLayer.order = batch.newOrder;
    } else if (batch.type === 'move-group') {
        // Move pieces back to old positions
        for (const action of batch.actions) {
            const { sk, oldQ, oldR, newQ, newR, type } = action;
            const [qStr, rStr, slotStr] = sk.split(',');
            const slot = parseInt(slotStr);
            const mesh = elements.get(slotKey(newQ, newR, slot));
            if (mesh) {
                const oldSk = slotKey(oldQ, oldR, slot);
                elements.delete(slotKey(newQ, newR, slot));
                elementTypes.delete(slotKey(newQ, newR, slot));
                pieceToLayer.delete(slotKey(newQ, newR, slot));
                elements.set(oldSk, mesh);
                elementTypes.set(oldSk, type);
                const layerId = pieceToLayer.get(slotKey(newQ, newR, slot));
                if (layerId) pieceToLayer.set(oldSk, layerId);
                const {x, y} = cellPos(oldQ, oldR);
                mesh.position.set(x, y, mesh.position.z);
                mesh.userData.q = oldQ;
                mesh.userData.r = oldR;
            }
        }
        // Update selectedPieces and selectionHighlights
        for (const action of batch.actions) {
            const { sk, oldQ, oldR, newQ, newR } = action;
            const [qStr, rStr, slotStr] = sk.split(',');
            const slot = parseInt(slotStr);
            const oldSk = slotKey(oldQ, oldR, slot);
            const newSk = slotKey(newQ, newR, slot);
            if (selectedPieces.has(newSk)) {
                selectedPieces.delete(newSk);
                selectedPieces.add(oldSk);
            }
            const hl = selectionHighlights.get(newSk);
            if (hl) {
                const {x, y} = cellPos(oldQ, oldR);
                hl.outline.position.set(x, y, hl.outline.position.z);
                hl.overlay.position.set(x, y, hl.overlay.position.z);
                selectionHighlights.delete(newSk);
                selectionHighlights.set(oldSk, hl);
            }
        }
        refreshAllNeighborBorders(batch.actions.map(a => ({ q: a.oldQ, r: a.oldR, type: a.type })));
    } else if (batch.type === 'move-selection') {
        for (const { sk, oldLayerId } of batch.movedPieces) {
            pieceToLayer.set(sk, oldLayerId);
            applyLayerColorToPiece(sk, oldLayerId);
            applyLayerVisibilityToPiece(sk, oldLayerId);
        }
    }
    updateStats();
    renderLayersList();
    updateGroupBtn();
}

function redoLastBatch() {
    if (redoStack.length === 0) return;
    const batch = redoStack.pop();
    if (batch.type === 'mirror') {
        mirrorDesign(batch.axis);
        undoStack.push(batch);
        updateStats();
        return;
    }
    undoStack.push(batch);
    if (batch.type === 'paint') {
        for (const action of batch.actions) {
            const geo = buildGeometry(action.type);
            if (!geo) continue;
            const candFoot = worldFootprint(action.type, action.q, action.r);
            collectOverlapSlotKeys(candFoot, action.type).forEach(sk => { if (sk !== action.sk) removeSlot(sk); });
            const mesh = new THREE.Mesh(geo, ELEM_MAT.clone());
            const { x, y } = cellPos(action.q, action.r);
            mesh.position.set(x, y, 0);
            mesh.userData = { q: action.q, r: action.r, slot: slotOf(action.type) };
            scene.add(mesh);
            elements.set(action.sk, mesh);
            elementTypes.set(action.sk, action.type);
            if (showBorder) addBorderMesh(action.sk, action.type, action.q, action.r);
        }
        refreshAllNeighborBorders(batch.actions);
    } else if (batch.type === 'erase') {
        for (const action of batch.actions) {
            removeSlot(action.sk);
        }
    } else if (batch.type === 'layer-create') {
        layers.set(batch.layerId, {
            name: batch.name,
            visible: true,
            locked: false,
            order: Math.max(0, ...[...layers.values()].map(l => l.order)) + 1,
            color: new THREE.Color(LAYER_COLORS[(parseInt(batch.layerId.split('_')[1]) || 0) % LAYER_COLORS.length])
        });
        activeLayerId = batch.layerId;
    } else if (batch.type === 'layer-delete') {
        layers.delete(batch.layerId);
        for (const { sk } of batch.movedPieces) {
            pieceToLayer.set(sk, 'default');
            applyLayerColorToPiece(sk, 'default');
            applyLayerVisibilityToPiece(sk, 'default');
        }
        if (activeLayerId === batch.layerId) activeLayerId = 'default';
    } else if (batch.type === 'layer-group') {
        layers.set(batch.newId, {
            name: `Groupe ${batch.newId}`,
            visible: true,
            locked: false,
            order: Math.max(0, ...[...layers.values()].map(l => l.order)) + 1,
            color: new THREE.Color(0xf39c12)
        });
        for (const { sk, oldLayerId } of batch.movedPieces) {
            pieceToLayer.set(sk, batch.newId);
            applyLayerColorToPiece(sk, batch.newId);
        }
        activeLayerId = batch.newId;
    } else if (batch.type === 'layer-duplicate') {
        const src = layers.get(batch.sourceId);
        if (src) {
            layers.set(batch.newId, {
                name: src.name + ' (copie)',
                visible: true,
                locked: false,
                order: Math.max(0, ...[...layers.values()].map(l => l.order)) + 1,
                color: src.color.clone()
            });
            for (const { sk } of batch.movedPieces) {
                pieceToLayer.set(sk, batch.newId);
                applyLayerColorToPiece(sk, batch.newId);
            }
            activeLayerId = batch.newId;
        }
    } else if (batch.type === 'layer-merge') {
        layers.delete(batch.sourceId);
        for (const { sk } of batch.movedPieces) {
            pieceToLayer.set(sk, batch.targetId);
            applyLayerColorToPiece(sk, batch.targetId);
            applyLayerVisibilityToPiece(sk, batch.targetId);
        }
        if (activeLayerId === batch.sourceId) activeLayerId = batch.targetId;
    } else if (batch.type === 'layer-rename') {
        const layer = layers.get(batch.layerId);
        if (layer) layer.name = batch.newName;
    } else if (batch.type === 'layer-color') {
        const layer = layers.get(batch.layerId);
        if (layer) {
            layer.color.set(batch.newColor);
            for (const [sk, lid] of pieceToLayer) {
                if (lid === batch.layerId) applyLayerColorToPiece(sk, batch.layerId);
            }
        }
    } else if (batch.type === 'layer-visibility') {
        const layer = layers.get(batch.layerId);
        if (layer) {
            layer.visible = batch.newVisible;
            for (const [sk, lid] of pieceToLayer) {
                if (lid === batch.layerId) applyLayerVisibilityToPiece(sk, batch.layerId);
            }
        }
    } else if (batch.type === 'layer-lock') {
        const layer = layers.get(batch.layerId);
        if (layer) layer.locked = batch.newLocked;
    } else if (batch.type === 'layer-reorder') {
        const layer = layers.get(batch.layerId);
        const targetLayer = [...layers.values()].find(l => l.order === batch.oldOrder);
        if (layer) layer.order = batch.newOrder;
        if (targetLayer && targetLayer !== layer) targetLayer.order = batch.oldOrder;
    } else if (batch.type === 'move-group') {
        // Move pieces to new positions
        for (const action of batch.actions) {
            const { sk, oldQ, oldR, newQ, newR, type } = action;
            const [qStr, rStr, slotStr] = sk.split(',');
            const slot = parseInt(slotStr);
            const mesh = elements.get(slotKey(oldQ, oldR, slot));
            if (mesh) {
                const newSk = slotKey(newQ, newR, slot);
                elements.delete(slotKey(oldQ, oldR, slot));
                elementTypes.delete(slotKey(oldQ, oldR, slot));
                pieceToLayer.delete(slotKey(oldQ, oldR, slot));
                elements.set(newSk, mesh);
                elementTypes.set(newSk, type);
                const layerId = pieceToLayer.get(slotKey(oldQ, oldR, slot));
                if (layerId) pieceToLayer.set(newSk, layerId);
                const {x, y} = cellPos(newQ, newR);
                mesh.position.set(x, y, mesh.position.z);
                mesh.userData.q = newQ;
                mesh.userData.r = newR;
            }
        }
        // Update selectedPieces and selectionHighlights
        for (const action of batch.actions) {
            const { sk, oldQ, oldR, newQ, newR } = action;
            const [qStr, rStr, slotStr] = sk.split(',');
            const slot = parseInt(slotStr);
            const oldSk = slotKey(oldQ, oldR, slot);
            const newSk = slotKey(newQ, newR, slot);
            if (selectedPieces.has(oldSk)) {
                selectedPieces.delete(oldSk);
                selectedPieces.add(newSk);
            }
            const hl = selectionHighlights.get(oldSk);
            if (hl) {
                const {x, y} = cellPos(newQ, newR);
                hl.outline.position.set(x, y, hl.outline.position.z);
                hl.overlay.position.set(x, y, hl.overlay.position.z);
                selectionHighlights.delete(oldSk);
                selectionHighlights.set(newSk, hl);
            }
        }
        refreshAllNeighborBorders(batch.actions.map(a => ({ q: a.newQ, r: a.newR, type: a.type })));
    } else if (batch.type === 'move-selection') {
        for (const { sk } of batch.movedPieces) {
            pieceToLayer.set(sk, batch.targetId);
            applyLayerColorToPiece(sk, batch.targetId);
            applyLayerVisibilityToPiece(sk, batch.targetId);
        }
    }
    updateStats();
    renderLayersList();
    updateGroupBtn();
}

function refreshAllNeighborBorders(actions) {
    if (!showBorder) return;
    const seen = new Set();
    for (const action of actions) {
        const key = `${action.q},${action.r}`;
        if (seen.has(key)) continue;
        seen.add(key);
        refreshNeighborBorders(action.q, action.r);
    }
}

// Clear redo stack on any new action
const _origRecordPaintAction = recordPaintAction;
const _origRecordEraseAction = recordEraseAction;
recordPaintAction = function(sk, q, r, type) {
    redoStack = [];
    _origRecordPaintAction(sk, q, r, type);
};
recordEraseAction = function(sk, q, r, type) {
    redoStack = [];
    _origRecordEraseAction(sk, q, r, type);
};

function paintAt(e) {
    if (activeTool === 'select') return;
    const cell = getHitCell(e); if (!cell) return;
    const {q, r, hitPt} = cell; if (activeTool === 'remove') { eraseAt(e); return; }
    const layer = layers.get(activeLayerId);
    if (layer && layer.locked) return;
    const cellId = `${q},${r}`; if (cellId === lastPaintKey) return; lastPaintKey = cellId;
    const cp = cellPos(q, r), concreteType = getResolvedType(activeTool, hitPt, cp), slot = slotOf(concreteType);
    const sk = slotKey(q, r, slot);
    if (!elements.has(sk)) { placeElement(q, r, concreteType); recordPaintAction(sk, q, r, concreteType); updateStats(); }
}

function eraseAt(e) {
    if (activeTool === 'select') return;
    const cell = getHitCell(e);
    if (!cell) return;
    const {q, r, hitPt} = cell; const cellId = `${q},${r}`; if (cellId === lastEraseKey) return; lastEraseKey = cellId;
    
    // Raycast against actual element meshes for precise slot-level erasing
    const activeCam = isOrtho ? orthoCamera : camera;
    raycaster.setFromCamera(ndcMouse, activeCam);
    const elementMeshes = Array.from(elements.values());
    const elemIntersects = raycaster.intersectObjects(elementMeshes);
    
    if (elemIntersects.length > 0) {
        const hitMesh = elemIntersects[0].object;
        let hitSk = null;
        for (const [sk, mesh] of elements) {
            if (mesh === hitMesh) { hitSk = sk; break; }
        }
        if (hitSk) {
            const type = elementTypes.get(hitSk);
            const layerId = pieceToLayer.get(hitSk);
            if (layerId && layers.get(layerId)?.locked) return;
            recordEraseAction(hitSk, q, r, type);
            removeSlot(hitSk);
            updateStats();
            return;
        }
    }
    
    // Fallback: erase all slots at this cell
    const slotTypes = occupiedSlots(q, r);
    if (slotTypes.length === 0) return;
    const toErase = [];
    for (const slotType of slotTypes) {
        const sk = slotKey(q, r, slotType);
        const m = elements.get(sk);
        if (m) {
            const layerId = pieceToLayer.get(sk);
            if (layerId && layers.get(layerId)?.locked) continue;
            const type = elementTypes.get(sk);
            toErase.push({ sk, type });
        }
    }
    if (toErase.length === 0) return;
    for (const { sk, type } of toErase) {
        recordEraseAction(sk, q, r, type);
    }
    toErase.forEach(({ sk }) => removeSlot(sk));
    updateStats();
}

// ─── Group Move Functions ───────────────────────────────────────────────────

function updateGroupDragPreview(dq, dr) {
    if (groupDragOriginalPositions.size === 0) {
        // First time, store original positions
        for (const sk of selectedPieces) {
            const [qStr, rStr, slot] = sk.split(',');
            const q = parseInt(qStr), r = parseInt(rStr);
            groupDragOriginalPositions.set(sk, {q, r});
        }
    }
    // Check if move is valid
    let canMove = true;
    for (const sk of selectedPieces) {
        const orig = groupDragOriginalPositions.get(sk);
        const newQ = orig.q + dq, newR = orig.r + dr;
        const type = elementTypes.get(sk);
        const movedFoot = worldFootprint(type, newQ, newR);
        elements.forEach((mesh, sk2) => {
            if (selectedPieces.has(sk2)) return;
            const { q: eq, r: er } = mesh.userData;
            const otherFoot = worldFootprint(elementTypes.get(sk2), eq, er);
            const overlap = overlapAreaBetween(movedFoot, otherFoot);
            if (overlap > OVERLAP_EPS) canMove = false;
        });
        if (!canMove) break;
    }
    // Move meshes
    for (const sk of selectedPieces) {
        const mesh = elements.get(sk);
        if (!mesh) continue;
        const orig = groupDragOriginalPositions.get(sk);
        const newQ = orig.q + dq, newR = orig.r + dr;
        const {x, y} = cellPos(newQ, newR);
        mesh.position.set(x, y, mesh.position.z);
        // Update highlights
        const hl = selectionHighlights.get(sk);
        if (hl) {
            hl.outline.position.set(x, y, hl.outline.position.z);
            hl.overlay.position.set(x, y, hl.overlay.position.z);
        }
        // Update emissive for valid/invalid
        const mat = mesh.material;
        if (canMove) {
            mat.emissive.setHex(0x444444); // dim highlight
        } else {
            mat.emissive.setHex(0x440000); // red for invalid
        }
    }
}

function clearGroupDragPreview() {
    for (const sk of selectedPieces) {
        const mesh = elements.get(sk);
        if (!mesh) continue;
        const orig = groupDragOriginalPositions.get(sk);
        if (orig) {
            const {x, y} = cellPos(orig.q, orig.r);
            mesh.position.set(x, y, mesh.position.z);
            const hl = selectionHighlights.get(sk);
            if (hl) {
                hl.outline.position.set(x, y, hl.outline.position.z);
                hl.overlay.position.set(x, y, hl.overlay.position.z);
            }
        }
        mesh.material.emissive.setHex(0x000000);
    }
    groupDragOriginalPositions.clear();
}

function commitGroupMove(dq, dr) {
     if (dq === 0 && dr === 0) return;
     // Check validity again
     let canMove = true;
     for (const sk of selectedPieces) {
         const orig = groupDragOriginalPositions.get(sk);
         const newQ = orig.q + dq, newR = orig.r + dr;
         const type = elementTypes.get(sk);
         const movedFoot = worldFootprint(type, newQ, newR);
         elements.forEach((mesh, sk2) => {
             if (selectedPieces.has(sk2)) return;
             const { q: eq, r: er } = mesh.userData;
             const otherFoot = worldFootprint(elementTypes.get(sk2), eq, er);
             const overlap = overlapAreaBetween(movedFoot, otherFoot);
             if (overlap > OVERLAP_EPS) canMove = false;
         });
         if (!canMove) break;
     }
     if (!canMove) {
         clearGroupDragPreview();
         return;
     }
     // Record for undo
     const actions = [];
     const newSelectedPieces = new Set();
     for (const sk of selectedPieces) {
         const orig = groupDragOriginalPositions.get(sk);
         const newQ = orig.q + dq, newR = orig.r + dr;
         const type = elementTypes.get(sk);
         actions.push({ sk, oldQ: orig.q, oldR: orig.r, newQ, newR, type });
     }
     undoStack.push({ type: 'move-group', actions });
     trimUndoStack(undoStack);
      // Perform move
      for (const action of actions) {
          const { sk, newQ, newR, type } = action;
           const [qrPart, slotPart] = sk.split("|");
           const [qStr, rStr] = qrPart.split(",");
           const slot = slotPart;
           const mesh = elements.get(sk);
         const newSk = slotKey(newQ, newR, slot);
         // Get layerId BEFORE removing from pieceToLayer
         const layerId = pieceToLayer.get(sk);
         // Remove old
         elements.delete(sk);
         elementTypes.delete(sk);
         pieceToLayer.delete(sk);
         // Add new
         elements.set(newSk, mesh);
         elementTypes.set(newSk, type);
         if (layerId) pieceToLayer.set(newSk, layerId);
         // Update position
         const {x, y} = cellPos(newQ, newR);
         mesh.position.set(x, y, mesh.position.z);
         mesh.userData.q = newQ;
         mesh.userData.r = newR;
         // Move highlights
         const hl = selectionHighlights.get(sk);
         if (hl) {
             hl.outline.position.set(x, y, hl.outline.position.z);
             hl.overlay.position.set(x, y, hl.overlay.position.z);
             selectionHighlights.delete(sk);
             selectionHighlights.set(newSk, hl);
         }
         // Add new key to selected pieces
         newSelectedPieces.add(newSk);
     }
     // Update selection with new keys
     selectedPieces.clear();
     for (const sk of newSelectedPieces) {
         selectedPieces.add(sk);
     }
      updateStats();
      groupDragOriginalPositions.clear();
  }

// ─── Layer System Functions ──────────────────────────────────────────────────
function createLayer(name, colorHex) {
    const id = 'layer_' + (nextLayerId++);
    const maxOrder = layers.size > 0 ? Math.max(...[...layers.values()].map(l => l.order)) : -1;
    const col = colorHex ? new THREE.Color(colorHex) : new THREE.Color(LAYER_COLORS[(nextLayerId - 1) % LAYER_COLORS.length]);
    layers.set(id, {
        name: name || `Groupe ${nextLayerId}`,
        visible: true,
        locked: false,
        order: maxOrder + 1,
        color: col
    });
    return id;
}

function deleteLayer(layerId) {
    if (layerId === 'default' || layers.size <= 1) return false;
    const movedPieces = [];
    for (const [sk, lid] of pieceToLayer) {
        if (lid === layerId) {
            pieceToLayer.set(sk, 'default');
            applyLayerColorToPiece(sk, 'default');
            applyLayerVisibilityToPiece(sk, 'default');
            movedPieces.push({ sk, oldLayerId: layerId });
        }
    }
    const layerData = { ...layers.get(layerId), color: '#' + layers.get(layerId).color.getHexString() };
    layers.delete(layerId);
    if (activeLayerId === layerId) activeLayerId = 'default';
    undoStack.push({ type: 'layer-delete', layerId, layerData, movedPieces });
    redoStack = [];
    renderLayersList();
    updateGroupBtn();
    return true;
}

function duplicateLayer(layerId) {
    const src = layers.get(layerId);
    if (!src) return;
    const newId = createLayer(src.name + ' (copie)', '#' + src.color.getHexString());
    const movedPieces = [];
    for (const [sk, lid] of pieceToLayer) {
        if (lid === layerId) {
            pieceToLayer.set(sk, newId);
            applyLayerColorToPiece(sk, newId);
            movedPieces.push({ sk, oldLayerId: layerId });
        }
    }
    undoStack.push({ type: 'layer-duplicate', sourceId: layerId, newId, movedPieces });
    redoStack = [];
    activeLayerId = newId;
    renderLayersList();
    updateGroupBtn();
}

function moveSelectionToLayer(targetLayerId) {
    if (selectedPieces.size === 0) return;
    const targetLayer = layers.get(targetLayerId);
    if (!targetLayer) return;
    const movedPieces = [];
    for (const sk of selectedPieces) {
        const oldLid = pieceToLayer.get(sk);
        if (oldLid === targetLayerId) continue;
        pieceToLayer.set(sk, targetLayerId);
        applyLayerColorToPiece(sk, targetLayerId);
        movedPieces.push({ sk, oldLayerId: oldLid });
    }
    if (movedPieces.length === 0) return;
    undoStack.push({ type: 'move-selection', targetId: targetLayerId, movedPieces });
    redoStack = [];
    selectedPieces.clear();
    clearAllHighlights();
    renderLayersList();
    updateGroupBtn();
}

function setActiveLayer(id) {
    activeLayerId = id;
    selectedPieces.clear();
    clearAllHighlights();
    for (const [sk, lid] of pieceToLayer) {
        if (lid === id) selectedPieces.add(sk);
    }
    highlightSelectedPieces();
    renderLayersList();
}

function setLayerVisibility(id, visible) {
    const layer = layers.get(id);
    if (!layer) return;
    const oldVisible = layer.visible;
    layer.visible = visible;
    for (const [sk, lid] of pieceToLayer) {
        if (lid === id) applyLayerVisibilityToPiece(sk, id);
    }
    undoStack.push({ type: 'layer-visibility', layerId: id, oldVisible, newVisible: visible });
    redoStack = [];
    renderLayersList();
}

function setLayerLocked(id, locked) {
    const layer = layers.get(id);
    if (!layer) return;
    const oldLocked = layer.locked;
    layer.locked = locked;
    undoStack.push({ type: 'layer-lock', layerId: id, oldLocked, newLocked: locked });
    redoStack = [];
    renderLayersList();
}

function setLayerColor(id, hex) {
    const layer = layers.get(id);
    if (!layer) return;
    const oldColor = '#' + layer.color.getHexString();
    layer.color.set(hex);
    for (const [sk, lid] of pieceToLayer) {
        if (lid === id) applyLayerColorToPiece(sk, id);
    }
    undoStack.push({ type: 'layer-color', layerId: id, oldColor, newColor: hex });
    redoStack = [];
    renderLayersList();
}

function setLayerName(id, name) {
    const layer = layers.get(id);
    if (!layer || !name.trim()) return;
    const oldName = layer.name;
    layer.name = name.trim();
    undoStack.push({ type: 'layer-rename', layerId: id, oldName, newName: name.trim() });
    redoStack = [];
    renderLayersList();
}

function reorderLayers(fromId, toId) {
    if (fromId === toId || !layers.has(fromId) || !layers.has(toId)) return;
    const fromLayer = layers.get(fromId);
    const toLayer = layers.get(toId);
    const tmpOrder = fromLayer.order;
    fromLayer.order = toLayer.order;
    toLayer.order = tmpOrder;
    undoStack.push({ type: 'layer-reorder', layerId: fromId, oldOrder: tmpOrder, newOrder: toLayer.order });
    redoStack = [];
    renderLayersList();
}

function applyLayerColorToPiece(sk, layerId) {
    const mesh = elements.get(sk);
    const layer = layers.get(layerId);
    if (!mesh || !layer) return;
    mesh.material.color.set(layer.color);
    mesh.material.emissive.set(layer.color);
    mesh.material.emissiveIntensity = 0.04;
    // Also update border mesh if it exists
    const borderMesh = borderMeshes.get(sk);
    if (borderMesh) {
        borderMesh.material.color.set(layer.color);
        borderMesh.material.emissive.set(layer.color);
    }
}

function applyLayerVisibilityToPiece(sk, layerId) {
    const mesh = elements.get(sk);
    const layer = layers.get(layerId);
    if (!mesh || !layer) return;
    mesh.visible = layer.visible;
}

function highlightSelectedPieces() {
    for (const sk of selectedPieces) {
        highlightSinglePiece(sk);
    }
}

function highlightSinglePiece(sk) {
    if (selectionHighlights.has(sk)) return;
    const mesh = elements.get(sk);
    if (!mesh) return;
    const geo = mesh.geometry;
    if (!geo) return;

    const edgesGeo = new THREE.EdgesGeometry(geo);
    const lineMat = new THREE.LineBasicMaterial({ color: 0xffdd00, transparent: true, opacity: 0.9 });
    const outline = new THREE.LineSegments(edgesGeo, lineMat);
    outline.position.copy(mesh.position);
    outline.rotation.copy(mesh.rotation);
    outline.scale.copy(mesh.scale).multiplyScalar(1.02);
    outline.renderOrder = 999;
    scene.add(outline);

    const overlayMat = new THREE.MeshBasicMaterial({
        color: 0xffdd00,
        transparent: true,
        opacity: 0.15,
        depthWrite: false,
        side: THREE.DoubleSide
    });
    const overlay = new THREE.Mesh(geo, overlayMat);
    overlay.position.copy(mesh.position);
    overlay.position.z += 0.5;
    overlay.rotation.copy(mesh.rotation);
    overlay.scale.copy(mesh.scale).multiplyScalar(1.01);
    overlay.renderOrder = 998;
    scene.add(overlay);

    selectionHighlights.set(sk, { outline, overlay, type: 'permanent' });
}

function clearPieceHighlight(sk) {
    const hl = selectionHighlights.get(sk);
    if (!hl) return;
    scene.remove(hl.outline);
    hl.outline.geometry.dispose();
    hl.outline.material.dispose();
    scene.remove(hl.overlay);
    hl.overlay.geometry.dispose();
    hl.overlay.material.dispose();
    selectionHighlights.delete(sk);
}

function clearAllHighlights() {
    for (const [, hl] of selectionHighlights) {
        scene.remove(hl.outline);
        hl.outline.geometry.dispose();
        hl.outline.material.dispose();
        scene.remove(hl.overlay);
        hl.overlay.geometry.dispose();
        hl.overlay.material.dispose();
    }
    selectionHighlights.clear();
}

function updateGroupBtn() {
    const btn = document.getElementById('groupLayerBtn');
    if (btn) btn.disabled = selectedPieces.size < 2;
}

function getLayerPieceCount(layerId) {
    let count = 0;
    for (const [, lid] of pieceToLayer) { if (lid === layerId) count++; }
    return count;
}

function renderLayersList() {
    const container = document.getElementById('layers-list');
    if (!container) return;
    container.innerHTML = '';
    const sortedLayers = [...layers.entries()].sort((a, b) => b[1].order - a[1].order);
    for (const [id, layer] of sortedLayers) {
        const row = document.createElement('div');
        row.className = 'layer-row' + (id === activeLayerId ? ' active' : '');
        row.dataset.layerId = id;
        row.draggable = false;

        const count = getLayerPieceCount(id);

        // Drag handle
        const drag = document.createElement('span');
        drag.className = 'layer-drag';
        drag.textContent = '⠿';
        drag.draggable = true;
        drag.addEventListener('dragstart', e => {
            dragLayerId = id;
            row.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
        });
        drag.addEventListener('dragend', () => {
            dragLayerId = null;
            row.classList.remove('dragging');
            document.querySelectorAll('.layer-row.drag-over').forEach(r => r.classList.remove('drag-over'));
        });
        row.appendChild(drag);

        // Eye icon
        const eyeBtn = document.createElement('button');
        eyeBtn.className = 'layer-icon-btn' + (layer.visible ? '' : ' layer-hidden');
        eyeBtn.innerHTML = layer.visible
            ? '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>'
            : '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/></svg>';
        eyeBtn.addEventListener('click', e => { e.stopPropagation(); setLayerVisibility(id, !layer.visible); });
        row.appendChild(eyeBtn);

        // Lock icon
        const lockBtn = document.createElement('button');
        lockBtn.className = 'layer-icon-btn' + (layer.locked ? ' layer-locked' : '');
        lockBtn.innerHTML = layer.locked
            ? '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>'
            : '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm6-9h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6h1.9c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10z"/></svg>';
        lockBtn.addEventListener('click', e => { e.stopPropagation(); setLayerLocked(id, !layer.locked); });
        row.appendChild(lockBtn);

        // Color square
        const colorDiv = document.createElement('div');
        colorDiv.className = 'layer-color';
        colorDiv.style.backgroundColor = '#' + layer.color.getHexString();
        colorDiv.addEventListener('click', e => {
            e.stopPropagation();
            pendingColorLayerId = id;
            document.getElementById('layerColorPicker').click();
        });
        row.appendChild(colorDiv);

        // Name
        const nameSpan = document.createElement('span');
        nameSpan.className = 'layer-name';
        nameSpan.textContent = layer.name;
        nameSpan.addEventListener('dblclick', e => {
            e.stopPropagation();
            const input = document.createElement('input');
            input.className = 'layer-name-input';
            input.value = layer.name;
            nameSpan.replaceWith(input);
            input.focus();
            input.select();
            const finish = () => { setLayerName(id, input.value); renderLayersList(); };
            input.addEventListener('blur', finish);
            input.addEventListener('keydown', ev => { if (ev.key === 'Enter') input.blur(); if (ev.key === 'Escape') { input.value = layer.name; input.blur(); } });
        });
        row.appendChild(nameSpan);

        // Piece count
        const countSpan = document.createElement('span');
        countSpan.className = 'layer-piece-count';
        countSpan.textContent = count;
        row.appendChild(countSpan);

        // Click to select layer
        row.addEventListener('click', e => {
            if (e.target.closest('.layer-icon-btn') || e.target.closest('.layer-color') || e.target.closest('.layer-name-input') || e.target.closest('.layer-drag')) return;
            setTool('select');
            setActiveLayer(id);
        });

        // Context menu
        row.addEventListener('contextmenu', e => {
            e.preventDefault();
            e.stopPropagation();
            showLayerContextMenu(e.clientX, e.clientY, id);
        });

        // Drag over for reordering
        row.addEventListener('dragover', e => {
            e.preventDefault();
            if (dragLayerId && dragLayerId !== id) row.classList.add('drag-over');
        });
        row.addEventListener('dragleave', () => row.classList.remove('drag-over'));
        row.addEventListener('drop', e => {
            e.preventDefault();
            row.classList.remove('drag-over');
            if (dragLayerId && dragLayerId !== id) reorderLayers(dragLayerId, id);
        });

        container.appendChild(row);
    }
}

function showLayerContextMenu(x, y, layerId) {
    closeContextMenu();
    contextMenuEl = document.createElement('div');
    contextMenuEl.className = 'layer-context';
    contextMenuEl.style.left = x + 'px';
    contextMenuEl.style.top = y + 'px';

    const layer = layers.get(layerId);
    if (!layer) return;

    // Duplicate
    const dupItem = document.createElement('div');
    dupItem.className = 'layer-context-item';
    dupItem.textContent = LANG[currentLang]['layer-duplicate'] || 'Dupliquer';
    dupItem.addEventListener('click', () => { duplicateLayer(layerId); closeContextMenu(); });
    contextMenuEl.appendChild(dupItem);

    // Move selection here
    if (selectedPieces.size > 0) {
        const moveSel = document.createElement('div');
        moveSel.className = 'layer-context-item';
        moveSel.textContent = LANG[currentLang]['move-selection-to-layer'] || 'Déplacer la sélection ici';
        moveSel.addEventListener('click', () => { moveSelectionToLayer(layerId); closeContextMenu(); });
        contextMenuEl.appendChild(moveSel);
    }

    // Merge with...
    const otherLayers = [...layers.keys()].filter(id => id !== layerId);
    if (otherLayers.length > 0) {
        const mergeItem = document.createElement('div');
        mergeItem.className = 'layer-context-item';
        mergeItem.textContent = LANG[currentLang]['layer-merge'] || 'Fusionner avec...';
        mergeItem.style.position = 'relative';

        const submenu = document.createElement('div');
        submenu.className = 'layer-submenu';
        submenu.style.display = 'none';
        for (const oid of otherLayers) {
            const subItem = document.createElement('div');
            subItem.className = 'layer-context-item';
            subItem.textContent = layers.get(oid).name;
            subItem.addEventListener('click', e => { e.stopPropagation(); mergeLayers(layerId, oid); closeContextMenu(); });
            submenu.appendChild(subItem);
        }
        mergeItem.appendChild(submenu);

        mergeItem.addEventListener('mouseenter', () => { submenu.style.display = 'block'; });
        mergeItem.addEventListener('mouseleave', () => { submenu.style.display = 'none'; });
        submenu.addEventListener('mouseenter', () => { submenu.style.display = 'block'; });
        submenu.addEventListener('mouseleave', () => { submenu.style.display = 'none'; });

        contextMenuEl.appendChild(mergeItem);
    }

    // Delete (not for default)
    if (layerId !== 'default' && layers.size > 1) {
        const delItem = document.createElement('div');
        delItem.className = 'layer-context-item danger';
        delItem.textContent = LANG[currentLang]['layer-delete'] || 'Supprimer';
        delItem.addEventListener('click', () => {
            if (confirm(LANG[currentLang]['confirm-layer-delete'] || 'Supprimer ce calque ?')) {
                deleteLayer(layerId);
            }
            closeContextMenu();
        });
        contextMenuEl.appendChild(delItem);
    }

    document.body.appendChild(contextMenuEl);

    // Adjust position if off-screen
    const rect = contextMenuEl.getBoundingClientRect();
    if (rect.right > window.innerWidth) contextMenuEl.style.left = (window.innerWidth - rect.width - 8) + 'px';
    if (rect.bottom > window.innerHeight) contextMenuEl.style.top = (window.innerHeight - rect.height - 8) + 'px';
}

function closeContextMenu() {
    if (contextMenuEl) { contextMenuEl.remove(); contextMenuEl = null; }
}

document.addEventListener('click', closeContextMenu);

// Color picker handler
document.getElementById('layerColorPicker').addEventListener('change', e => {
    if (pendingColorLayerId) {
        setLayerColor(pendingColorLayerId, e.target.value);
        pendingColorLayerId = null;
    }
});

// New layer button
document.getElementById('newLayerBtn').addEventListener('click', () => {
    const newId = createLayer();
    activeLayerId = newId;
    if (selectedPieces.size > 0) {
        const movedPieces = [];
        for (const sk of selectedPieces) {
            const oldLid = pieceToLayer.get(sk);
            pieceToLayer.set(sk, newId);
            applyLayerColorToPiece(sk, newId);
            movedPieces.push({ sk, oldLayerId: oldLid });
        }
        selectedPieces.clear();
        clearAllHighlights();
        undoStack.push({ type: 'layer-group', newId, movedPieces });
    } else {
        undoStack.push({ type: 'layer-create', layerId: newId, name: layers.get(newId).name });
    }
    redoStack = [];
    renderLayersList();
    updateGroupBtn();
});

// Group selection button
document.getElementById('groupLayerBtn').addEventListener('click', () => {
    if (selectedPieces.size >= 2) groupSelectedPieces();
});

// ─── Session : sauvegarde / chargement ───────────────────────────────────────
const SESSION_KEY = 'hsw_session_v1';

function serializeSession() {
    const data = [];
    elements.forEach((mesh, sk) => {
        const type = elementTypes.get(sk);
        const { q, r } = mesh.userData;
        const layerId = pieceToLayer.get(sk) || 'default';
        data.push({ q, r, type, layerId });
    });
    const layersData = {};
    layers.forEach((layer, id) => {
        layersData[id] = {
            name: layer.name,
            visible: layer.visible,
            locked: layer.locked,
            order: layer.order,
            color: '#' + layer.color.getHexString()
        };
    });
    return {
        version: '1.3.0',
        lang: currentLang,
        shoulderDir,
        showBorder,
        elements: data,
        layers: layersData,
        activeLayerId,
        nextLayerId,
        savedAt: new Date().toISOString()
    };
}

// ─── Auto-save helper ────────────────────────────────────────────────────────
let autoSaveTimer = null;
function triggerAutoSave() {
    clearTimeout(autoSaveTimer);
    autoSaveTimer = setTimeout(() => {
        try {
            localStorage.setItem('hsw_session_v1', JSON.stringify(serializeSession()));
        } catch(e) {
            console.warn('Auto-save failed:', e);
        }
    }, 1500);
}

// ─── Stats ───────────────────────────────────────────────────────────────────
function updateStats() {
    document.getElementById('hexCount').innerText = elements.size;
    if (!elements.size) { document.getElementById('pieceSize').textContent='— × —'; triggerAutoSave(); return; }
    const HALF_H = HEX_H / 2;
    let minX=Infinity, maxX=-Infinity, minY=Infinity, maxY=-Infinity;
    elements.forEach((mesh, sk) => {
        const type = elementTypes.get(sk), {x:cx, y:cy} = mesh.position;
        const isHalfTop = type==='trap_1' || type==='trapFix_1' || type==='trapFull_1';
        const isHalfBot = type==='trap_4' || type==='trapFix_4' || type==='trapFull_4';
        minX = Math.min(minX, cx - HEX_S); maxX = Math.max(maxX, cx + HEX_S);
        minY = Math.min(minY, cy - (isHalfTop ? 0 : HALF_H)); maxY = Math.max(maxY, cy + (isHalfBot  ? 0 : HALF_H));
    });
    document.getElementById('pieceSize').textContent = `${(maxX-minX).toFixed(1)} × ${(maxY-minY).toFixed(1)} mm,`;
    triggerAutoSave();
}

